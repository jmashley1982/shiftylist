<nav class="navbar">
  <a href="<%= adminUrl() %>" class="brand">
    <img src="<%= staffUrl('/vvas-logo.png') %>" alt="VVAS">
    <img src="<%= staffUrl('/shiftylist-logo.png') %>" alt="ShiftyList" class="brand-platform-logo">
  </a>
  <a href="/admin" class="btn btn-ghost btn-sm" style="min-height:36px;padding:7px 12px;">← Dashboard</a>
</nav>

<nav class="admin-tab-nav">
  <a href="<%= adminUrl() %>" class="admin-tab-link <%= active === 'dashboard' ? 'active' : '' %>">
    <span class="tab-icon">🏠</span>
    <span>Home</span>
  </a>
  <a href="<%= adminUrl('/employees') %>" class="admin-tab-link <%= active === 'employees' ? 'active' : '' %>">
    <span class="tab-icon">👥</span>
    <span>Staff</span>
  </a>
  <a href="<%= adminUrl('/build') %>" class="admin-tab-link <%= active === 'shifts' ? 'active' : '' %>">
    <span class="tab-icon">📋</span>
    <span>Shifts</span>
  </a>
  <a href="<%= adminUrl('/company') %>" class="admin-tab-link <%= active === 'company' ? 'active' : '' %>">
    <span class="tab-icon">🎯</span>
    <span>Goals</span>
  </a>
  <a href="<%= adminUrl('/live') %>" class="admin-tab-link <%= active === 'live' ? 'active' : '' %>">
    <span class="tab-icon">🟢</span>
    <span>Live</span>
  </a>
  <a href="<%= adminUrl('/schedule') %>" class="admin-tab-link <%= active === 'schedule' ? 'active' : '' %>">
    <span class="tab-icon">🗓️</span>
    <span>Schedule</span>
  </a>
  <a href="<%= adminUrl('/reports') %>" class="admin-tab-link <%= active === 'reports' ? 'active' : '' %>">
    <span class="tab-icon">📊</span>
    <span>Reports</span>
  </a>
  <a href="<%= adminUrl('/notice') %>" class="admin-tab-link <%= active === 'notice' ? 'active' : '' %>">
    <span class="tab-icon">📢</span>
    <span>Notice</span>
  </a>
</nav>

<script>
  // Eight tabs no longer fit a phone, so the bar scrolls sideways (see
  // .admin-tab-nav in style.css). Pull the current tab into view so you can
  // always see where you are, whichever end of the bar it sits at. No-op on
  // desktop, where the bar is a vertical sidebar that fits everything.
  (function () {
    var current = document.querySelector('.admin-tab-link.active');
    if (current && current.scrollIntoView) {
      current.scrollIntoView({ inline: 'center', block: 'nearest' });
    }
  })();
</script>
