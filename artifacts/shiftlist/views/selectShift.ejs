<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Select Shift</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="page-center">
    <div class="card">
      <img src="/vvas-logo.png" alt="Viking Vapor & Smoke" class="card-logo">
      <p style="font-size:0.88rem; color:var(--muted); margin-bottom:4px;">Hi, <%= employeeName %>!</p>
      <p style="font-size:0.85rem; color:var(--muted); margin-bottom:24px;">Which shift are you working today?</p>

      <form method="POST" action="/select-shift" class="form-stack">
        <div class="form-group">
          <% shifts.forEach(function(shift) { %>
            <label style="display:flex; align-items:center; gap:12px; padding:12px 14px; border:1px solid var(--border); border-radius:10px; margin-bottom:10px; cursor:pointer; transition: border-color 0.15s;">
              <input type="radio" name="shiftId" value="<%= shift.id %>" required style="width:18px; height:18px;">
              <span style="font-size:1rem; font-weight:600;"><%= shift.name %></span>
            </label>
          <% }); %>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Start My Shift</button>
      </form>

      <a href="/logout" class="btn btn-ghost btn-full" style="margin-top:12px;">Not me — Log out</a>
    </div>
  </div>
</body>
</html>
