<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Schedule</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'schedule' }) %>
  <div class="main-content">
    <div class="page-header" style="margin-top:12px;">
      <h1>Schedule</h1>
      <p>Publish daily shifts for staff to pick from</p>
    </div>

    <div style="display:flex; gap:8px; align-items:center; margin-bottom:16px;">
      <a href="/admin/schedule?date=<%= prevDate %>" class="btn btn-ghost btn-sm">←</a>
      <div style="display:flex; align-items:center; gap:8px; flex:1;">
        <input type="date" id="datePicker" value="<%= date %>" style="flex:1; font-size:0.95rem; padding:6px 10px;">
        <button onclick="goToDate()" class="btn btn-primary btn-sm">Go</button>
      </div>
      <a href="/admin/schedule?date=<%= nextDate %>" class="btn btn-ghost btn-sm">→</a>
    </div>

    <% if (date === today) { %>
      <div class="alert alert-info" style="margin-bottom:16px;">Today: <%= formatDateDisplay(date) %></div>
    <% } else { %>
      <div style="font-size:0.85rem; color:var(--muted); margin-bottom:16px; text-align:center;">
        <%= formatDateDisplay(date) %>
      </div>
    <% } %>

    <% shifts.forEach(function(shift) {
      const ds = dailyShiftMap[shift.id];
      const isPublished = ds?.is_published === true;
      const myTasks = dailyTasksByShift[shift.id] || [];
      const tplTasks = templateTasksByShift[shift.id] || [];
    %>
      <div class="panel" style="margin-bottom:16px;">
        <div class="panel-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
          <div style="display:flex; align-items:center; gap:12px;">
            <h2><span class="shift-badge" style="font-size:0.9rem;"><%= shift.name %></span></h2>
            <% if (isPublished) { %>
              <span style="font-size:0.75rem; background:var(--success); color:white; padding:2px 8px; border-radius:4px;">Published</span>
            <% } else { %>
              <span style="font-size:0.75rem; background:var(--muted); color:white; padding:2px 8px; border-radius:4px;">Draft</span>
            <% } %>
          </div>
          <div style="display:flex; gap:8px;">
            <% if (!isPublished) { %>
              <form method="POST" action="/admin/schedule/<%= date %>/<%= shift.id %>/publish" style="display:inline;">
                <button type="submit" class="btn btn-success btn-sm">Publish</button>
              </form>
              <% if (myTasks.length === 0 && tplTasks.length > 0) { %>
                <form method="POST" action="/admin/schedule/<%= date %>/<%= shift.id %>/copy-template" style="display:inline;">
                  <button type="submit" class="btn btn-primary btn-sm">Copy from Template</button>
                </form>
              <% } %>
            <% } else { %>
              <form method="POST" action="/admin/schedule/<%= date %>/<%= shift.id %>/unpublish" style="display:inline;">
                <button type="submit" class="btn btn-ghost btn-sm">Unpublish</button>
              </form>
            <% } %>
          </div>
        </div>

        <% if (isPublished || myTasks.length > 0) { %>
          <form method="POST" action="/admin/schedule/<%= date %>/<%= shift.id %>/add-task" style="display:flex; gap:8px; margin-bottom:12px;">
            <select name="taskId" required style="flex:1;">
              <option value="">Add task…</option>
              <% tasks.forEach(function(t) { %>
                <option value="<%= t.id %>"><%= t.name %></option>
              <% }); %>
            </select>
            <button type="submit" class="btn btn-primary btn-sm">Add</button>
          </form>

          <% if (myTasks.length > 0) { %>
            <div style="display:flex; flex-direction:column; gap:8px;">
              <% myTasks.forEach(function(task, idx) { %>
                <div style="display:flex; align-items:center; gap:8px; padding:8px 0; border-bottom:1px solid var(--border);">
                  <span style="color:var(--muted); font-size:0.78rem; font-weight:700; min-width:24px;">#<%= task.display_order %></span>
                  <span style="flex:1; font-size:0.9rem;"><%= task.task_name %></span>
                  <div style="display:flex; gap:4px;">
                    <% if (idx > 0) { %>
                      <form method="POST" action="/admin/schedule/<%= date %>/<%= ds.id %>/move-task/<%= task.id %>" style="display:inline;">
                        <input type="hidden" name="direction" value="up">
                        <button type="submit" class="btn btn-ghost btn-sm">↑</button>
                      </form>
                    <% } %>
                    <% if (idx < myTasks.length - 1) { %>
                      <form method="POST" action="/admin/schedule/<%= date %>/<%= ds.id %>/move-task/<%= task.id %>" style="display:inline;">
                        <input type="hidden" name="direction" value="down">
                        <button type="submit" class="btn btn-ghost btn-sm">↓</button>
                      </form>
                    <% } %>
                    <form method="POST" action="/admin/schedule/<%= date %>/<%= shift.id %>/remove-task/<%= task.id %>" style="display:inline;" onsubmit="return confirm('Remove this task?')">
                      <button type="submit" class="btn btn-danger btn-sm">✕</button>
                    </form>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p style="color:var(--muted); font-size:0.88rem;">No tasks yet. Add tasks or copy from template.</p>
          <% } %>
        <% } else { %>
          <p style="color:var(--muted); font-size:0.88rem;">Shift not published yet. Click <strong>Publish</strong> or <strong>Copy from Template</strong> to make it available.</p>
        <% } %>
      </div>
    <% }); %>
  </div>

  <script>
    function goToDate() {
      const d = document.getElementById('datePicker').value;
      if (d) window.location.href = '/admin/schedule?date=' + d;
    }
  </script>
</body>
</html>
