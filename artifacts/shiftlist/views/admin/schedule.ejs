<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Schedule</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'schedule' }) %>
  <div class="main-content">
    <div class="page-header" style="margin-top:12px;">
      <h1>Schedule</h1>
      <p>Assign employees to shifts by day</p>
    </div>

    <div class="panel">
      <div class="panel-header"><h2>Add Shift</h2></div>
      <% if (employees.length === 0) { %>
        <div class="alert alert-info" style="margin-bottom:0;">No employees yet. <a href="/admin/employees">Add staff first →</a></div>
      <% } else if (shiftNames.length === 0) { %>
        <div class="alert alert-info" style="margin-bottom:0;">No shift templates yet. <a href="/admin/shifts">Create shifts first →</a></div>
      <% } else { %>
        <form method="POST" action="/admin/schedule/add" class="form-stack">
          <div class="form-group">
            <label>Date</label>
            <input type="date" name="date" min="<%= today %>" max="<%= maxDate %>" value="<%= today %>" required>
          </div>
          <div class="form-group">
            <label>Employee</label>
            <select name="employee_id" required>
              <option value="">Select employee…</option>
              <% employees.forEach(function(emp) { %>
                <option value="<%= emp.id %>"><%= emp.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>Shift</label>
            <select name="shift_name" required>
              <option value="">Select shift…</option>
              <% shiftNames.forEach(function(s) { %>
                <option value="<%= s %>"><%= s %></option>
              <% }); %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary btn-full">Assign Shift</button>
        </form>
      <% } %>
    </div>

    <div class="panel" style="padding:0; overflow:hidden;">
      <div style="padding:14px 18px; border-bottom:1px solid var(--border); background:var(--bg);">
        <h2 style="color:var(--text); font-size:0.85rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px;">Next 28 Days</h2>
      </div>
      <% dayObjects.forEach(function(day, i) { %>
        <div style="<%= day.isToday ? 'background:#fafbff;' : '' %> border-bottom:<%= i < dayObjects.length - 1 ? '1px solid var(--border)' : 'none' %>;">
          <div style="display:flex; align-items:flex-start; gap:12px; padding:14px 18px;">

            <!-- Date label -->
            <div style="min-width:80px; padding-top:2px;">
              <div style="font-size:0.88rem; font-weight:800; color:<%= day.isToday ? 'var(--brand)' : 'var(--text)' %>;">
                <%= day.label.split(',')[0] %>
              </div>
              <div style="font-size:0.8rem; color:var(--muted); font-weight:500;">
                <%= day.label.split(',').slice(1).join(',').trim() %>
              </div>
              <% if (day.isToday) { %>
                <div style="font-size:0.68rem; font-weight:800; color:var(--brand); text-transform:uppercase; letter-spacing:0.4px; margin-top:2px;">Today</div>
              <% } %>
            </div>

            <!-- Assignments -->
            <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:6px;">
              <% if (day.assignments.length > 0) { %>
                <% day.assignments.forEach(function(a) { %>
                  <div style="display:flex; align-items:center; gap:8px;">
                    <span style="flex:1; font-size:0.88rem; font-weight:600; color:var(--text-mid); min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= a.employee_name %></span>
                    <span class="shift-badge" style="flex-shrink:0; font-size:0.72rem; padding:3px 9px;"><%= a.shift_name %></span>
                    <form method="POST" action="/admin/schedule/delete/<%= a.id %>" style="flex-shrink:0;">
                      <button type="submit" class="btn btn-danger btn-sm" style="min-height:30px; padding:5px 10px; font-size:0.78rem;" onclick="return confirm('Remove this shift?')">✕</button>
                    </form>
                  </div>
                <% }); %>
              <% } else { %>
                <span style="font-size:0.82rem; color:var(--muted-light); font-style:italic; padding-top:2px;">No assignments</span>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>
