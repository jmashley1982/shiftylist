<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'dashboard' }) %>
  <div class="main-content">
    <div class="page-header" style="margin-top:12px;">
      <h1>Dashboard</h1>
      <p>Overview of your team</p>
    </div>

    <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:12px; margin-bottom:16px;">
      <div class="panel" style="text-align:center;">
        <div style="font-size:2rem; font-weight:800; color:var(--brand);"><%= employeeCount %></div>
        <div style="font-size:0.85rem; color:var(--muted);">Staff</div>
      </div>
      <div class="panel" style="text-align:center;">
        <div style="font-size:2rem; font-weight:800; color:var(--brand);"><%= taskCount %></div>
        <div style="font-size:0.85rem; color:var(--muted);">Tasks</div>
      </div>
      <div class="panel" style="text-align:center;">
        <div style="font-size:2rem; font-weight:800; color:var(--brand);"><%= shiftCount %></div>
        <div style="font-size:0.85rem; color:var(--muted);">Shifts</div>
      </div>
      <div class="panel" style="text-align:center;">
        <div style="font-size:2rem; font-weight:800; color:var(--success);"><%= publishedCount %></div>
        <div style="font-size:0.85rem; color:var(--muted);">Published today</div>
      </div>
    </div>

    <div class="panel">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
        <h2 style="font-size:1rem;">Quick Links</h2>
      </div>
      <div style="display:flex; flex-direction:column; gap:8px;">
        <a href="/admin/schedule?date=<%= today %>" class="btn btn-primary btn-full">Schedule Today</a>
        <a href="/admin/shifts" class="btn btn-ghost btn-full">Edit Shift Templates</a>
        <a href="/admin/reports" class="btn btn-ghost btn-full">View Reports</a>
      </div>
    </div>
  </div>
</body>
</html>
