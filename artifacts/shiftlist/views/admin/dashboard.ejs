<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'dashboard' }) %>
  <div class="main-content">
    <div class="page-header" style="margin-top:12px;">
      <h1>Dashboard</h1>
      <p>Overview of your team</p>
    </div>

    <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:12px; margin-bottom:16px;">
      <div class="panel" style="text-align:center;">
        <div style="font-size:2rem; font-weight:800; color:var(--brand);"><%= employeeCount %></div>
        <div style="font-size:0.85rem; color:var(--muted);">Staff</div>
      </div>
      <div class="panel" style="text-align:center;">
        <div style="font-size:2rem; font-weight:800; color:var(--brand);"><%= shiftCount %></div>
        <div style="font-size:0.85rem; color:var(--muted);">Shifts</div>
      </div>
      <div class="panel" style="text-align:center;">
        <div style="font-size:2rem; font-weight:800; color:var(--brand);"><%= taskCount %></div>
        <div style="font-size:0.85rem; color:var(--muted);">Tasks</div>
      </div>
      <div class="panel" style="text-align:center;">
        <div style="font-size:2rem; font-weight:800; color:#f59e0b;"><%= customCount %></div>
        <div style="font-size:0.85rem; color:var(--muted);">Custom days</div>
      </div>
    </div>

    <div class="panel" style="margin-bottom:16px;">
      <h2 style="font-size:1rem; margin-bottom:12px;">Recent Activity <span style="font-size:0.78rem; font-weight:400; color:var(--muted);">— last 30 days</span></h2>
      <% if (staffActivity.length === 0) { %>
        <p style="color:var(--muted); font-size:0.9rem; margin:0;">No submissions yet.</p>
      <% } else { %>
        <div style="display:flex; flex-direction:column; gap:8px;">
          <% staffActivity.forEach(function(staff) { %>
            <a href="/admin/reports?employee=<%= encodeURIComponent(staff.employee_name) %>"
               style="display:flex; align-items:center; justify-content:space-between; text-decoration:none; padding:10px 12px; background:var(--surface2); border-radius:8px; border:1px solid var(--border); transition:border-color 0.15s;"
               onmouseover="this.style.borderColor='var(--brand)'" onmouseout="this.style.borderColor='var(--border)'">
              <div>
                <div style="font-weight:600; color:var(--text); font-size:0.95rem;"><%= staff.employee_name %></div>
                <div style="font-size:0.78rem; color:var(--muted); margin-top:2px;">
                  <%= staff.submission_count %> submission<%= staff.submission_count === 1 ? '' : 's' %>
                </div>
              </div>
              <div style="text-align:right;">
                <% var pct = staff.avg_completion_pct; %>
                <div style="font-size:1.25rem; font-weight:800; color:<%= pct >= 90 ? 'var(--brand)' : pct >= 70 ? '#f59e0b' : '#ef4444' %>;">
                  <%= pct !== null ? pct + '%' : '—' %>
                </div>
                <div style="font-size:0.72rem; color:var(--muted);">avg completion</div>
              </div>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="panel">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
        <h2 style="font-size:1rem;">Quick Links</h2>
      </div>
      <div style="display:flex; flex-direction:column; gap:8px;">
        <a href="/admin/shifts" class="btn btn-primary btn-full">Build Shift Checklists</a>
        <a href="/admin/employees" class="btn btn-ghost btn-full">Manage Staff</a>
        <a href="/admin/reports" class="btn btn-ghost btn-full">View Reports</a>
      </div>
    </div>
  </div>
</body>
</html>
