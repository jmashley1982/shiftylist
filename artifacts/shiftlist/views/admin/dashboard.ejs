<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Dashboard</title>
  <link rel="stylesheet" href="<%= staffUrl('/style.css') %>">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'dashboard' }) %>
  <div class="main-content">

    <div class="page-header" style="margin-top:12px; display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:20px;">
      <div>
        <h1 style="margin-bottom:3px;">Dashboard</h1>
        <p style="margin:0;"><%= formatDateDisplay(today) %></p>
      </div>
      <div style="display:flex; align-items:center; gap:10px; margin-top:4px;">
        <span id="liveBadge" class="live-badge"><span class="live-badge-dot"></span><span id="liveBadgeLabel">LIVE</span></span>
        <span id="refreshCountdown" style="font-size:0.78rem; color:var(--muted);"></span>
      </div>
    </div>

    <% if (yesterdayNotes.length > 0) { %>
    <div id="notesPanel" style="margin-bottom:20px;">
      <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:rgba(245,158,11,.1); border:1px solid rgba(245,158,11,.35); border-radius:10px 10px 0 0; cursor:pointer; user-select:none;" onclick="toggleNotes()">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="font-size:1rem;">📝</span>
          <span style="font-size:0.82rem; font-weight:800; color:#f59e0b; text-transform:uppercase; letter-spacing:0.07em;">
            Staff notes from <%= formatDateDisplay(yesterday) %>
          </span>
          <span style="font-size:0.75rem; font-weight:600; padding:1px 8px; background:rgba(245,158,11,.2); color:#f59e0b; border-radius:20px; border:1px solid rgba(245,158,11,.3);">
            <%= yesterdayNotes.length %>
          </span>
        </div>
        <span id="notesChevron" style="font-size:0.85rem; color:#f59e0b; transition:transform 0.2s;">▲</span>
      </div>
      <div id="notesBody" style="border:1px solid rgba(245,158,11,.25); border-top:none; border-radius:0 0 10px 10px; background:var(--card); overflow:hidden;">
        <div style="display:flex; flex-direction:column; gap:0;">
          <% yesterdayNotes.forEach(function(note, i) { %>
            <div style="padding:12px 16px; <%= i < yesterdayNotes.length - 1 ? 'border-bottom:1px solid var(--border);' : '' %> display:flex; flex-direction:column; gap:4px;">
              <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                <span style="font-weight:700; font-size:0.9rem; color:var(--text);"><%= note.employee_name %></span>
                <span class="shift-badge" style="font-size:0.72rem; padding:1px 8px;"><%= note.shift_name %></span>
                <span style="font-size:0.75rem; color:var(--muted); margin-left:auto; white-space:nowrap;"><%= formatLocalTime(note.submitted_at) %></span>
              </div>
              <p style="margin:0; font-size:0.88rem; color:var(--text-mid); line-height:1.5; white-space:pre-wrap;"><%= note.notes %></p>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
    <% } %>

    <% if (notYetOpened.length > 0) { %>
    <div class="alert alert-warning" style="margin-bottom:20px; display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
      <span>⏰</span>
      <span>
        Scheduled today, not opened yet:
        <strong><%= notYetOpened.join(', ') %></strong>
      </span>
      <a href="<%= adminUrl('/schedule') %>" style="margin-left:auto; color:inherit; font-weight:700; text-decoration:underline; white-space:nowrap;">Schedule →</a>
    </div>
    <% } %>

    <div class="dash-grid">

      <!-- ── LEFT / MAIN COLUMN ─────────────────────────────────── -->
      <div>

        <!-- Today's Shifts -->
        <div style="margin-bottom:20px;">
          <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--muted); margin-bottom:10px;">Today's Shifts</div>
          <div style="display:flex; flex-direction:column; gap:10px;" id="shiftStatusGrid">
            <% if (shiftData.length === 0) { %>
              <div class="panel" style="padding:14px 16px;">
                <p style="color:var(--muted); font-size:0.88rem; margin:0;">No shifts set up yet. <a href="<%= adminUrl('/build') %>" style="color:var(--brand);">Create one →</a></p>
              </div>
            <% } %>
            <% shiftData.forEach(function(sd) { %>
              <%
                var sub = null;
                for (var i = 0; i < todaySubmissions.length; i++) {
                  if (todaySubmissions[i].shift_name.toLowerCase() === sd.shift.name.toLowerCase()) {
                    sub = todaySubmissions[i]; break;
                  }
                }
                var activeOnShift = activeSessions.filter(function(s) {
                  return s.shiftName.toLowerCase() === sd.shift.name.toLowerCase();
                });
                var pct = sd.total > 0 ? Math.round(sd.done / sd.total * 100) : 0;
              %>
              <div class="panel" data-shift-id="<%= sd.shift.id %>" style="padding:14px 16px;">
                <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:<%= sd.total > 0 ? '10px' : '0' %>;">
                  <span class="shift-badge" style="font-size:0.82rem;"><%= sd.shift.name %></span>

                  <% if (sub) { %>
                    <span style="font-size:0.72rem; font-weight:700; padding:2px 9px; background:rgba(56,182,160,.14); color:var(--brand); border-radius:20px; border:1px solid rgba(56,182,160,.3);">✓ Submitted<%= sub.count > 1 ? ' (' + sub.count + ')' : '' %></span>
                  <% } else { %>
                    <span style="font-size:0.72rem; font-weight:600; padding:2px 9px; background:rgba(156,163,175,.08); color:var(--muted); border-radius:20px; border:1px solid var(--border);">Pending</span>
                  <% } %>

                  <% if (activeOnShift.length > 0) { %>
                    <span style="font-size:0.72rem; padding:2px 9px; background:rgba(56,182,160,.08); color:var(--brand); border-radius:20px; display:flex; align-items:center; gap:5px; border:1px solid rgba(56,182,160,.2);">
                      <span style="width:6px; height:6px; border-radius:50%; background:var(--brand); display:inline-block; animation:live-dot-pulse 2s ease-in-out infinite;"></span>
                      <%= activeOnShift.length %> active
                    </span>
                  <% } %>

                  <% if (sd.total > 0) { %>
                    <span data-role="counter" style="margin-left:auto; font-size:0.88rem; font-weight:700; color:var(--text);"><%= sd.done %>/<%= sd.total %></span>
                  <% } %>
                </div>

                <% if (sd.total > 0) { %>
                  <div class="progress-bar-wrap" style="margin-bottom:<%= activeOnShift.length > 0 ? '7px' : '0' %>;">
                    <div class="progress-bar-fill" data-role="progress" style="width:<%= pct %>%"></div>
                  </div>
                  <% if (activeOnShift.length > 0) { %>
                    <div style="font-size:0.75rem; color:var(--muted);">On shift: <%= activeOnShift.map(function(s){ return s.employeeName; }).join(', ') %></div>
                  <% } %>
                <% } else { %>
                  <p style="font-size:0.8rem; color:var(--muted); margin:0;">No tasks configured for this shift.</p>
                <% } %>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- Staff Performance -->
        <div class="panel">
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; flex-wrap:wrap; gap:6px;">
            <h2 style="font-size:1rem; margin:0;">Staff Performance <span style="font-size:0.78rem; font-weight:400; color:var(--muted);">— last 30 days</span></h2>
            <a href="<%= adminUrl('/reports') %>" style="font-size:0.8rem; color:var(--brand); text-decoration:none; font-weight:600;">All reports →</a>
          </div>
          <% if (staffActivity.length === 0) { %>
            <p style="color:var(--muted); font-size:0.9rem; margin:0;">No submissions yet.</p>
          <% } else { %>
            <div style="display:flex; flex-direction:column; gap:6px;">
              <% staffActivity.forEach(function(staff) { %>
                <% var pct = staff.avg_completion_pct; %>
                <a href="<%= adminUrl('/reports') %>?employee=<%= encodeURIComponent(staff.employee_name) %>"
                   style="display:flex; align-items:center; gap:12px; text-decoration:none; padding:10px 12px; background:var(--surface2); border-radius:8px; border:1px solid var(--border); transition:border-color 0.15s;"
                   onmouseover="this.style.borderColor='var(--brand)'" onmouseout="this.style.borderColor='var(--border)'">
                  <div style="flex:1; min-width:0;">
                    <div style="font-weight:600; color:var(--text); font-size:0.92rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= staff.employee_name %></div>
                    <div style="font-size:0.75rem; color:var(--muted); margin-top:2px;"><%= staff.submission_count %> submission<%= staff.submission_count === 1 ? '' : 's' %></div>
                  </div>
                  <div style="text-align:right; flex-shrink:0;">
                    <div style="font-size:1.15rem; font-weight:800; color:<%= pct !== null && pct >= 90 ? 'var(--brand)' : pct !== null && pct >= 70 ? '#f59e0b' : '#ef4444' %>;">
                      <%= pct !== null ? pct + '%' : '—' %>
                    </div>
                    <div style="font-size:0.7rem; color:var(--muted);">avg completion</div>
                  </div>
                </a>
              <% }); %>
            </div>
          <% } %>
        </div>

      </div><!-- /left column -->

      <!-- ── RIGHT / SIDEBAR COLUMN ────────────────────────────── -->
      <div class="dash-sidebar">

        <!-- Currently Active -->
        <div class="panel" style="margin-bottom:14px;">
          <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--muted); margin-bottom:10px; display:flex; align-items:center; gap:7px;">
            <span style="width:7px; height:7px; border-radius:50%; background:var(--brand); display:inline-block; animation:live-dot-pulse 2s ease-in-out infinite; flex-shrink:0;"></span>
            Currently Active
          </div>
          <div id="activeSessionsList">
            <% if (activeSessions.length === 0) { %>
              <p style="color:var(--muted); font-size:0.85rem; margin:0;">No staff on shift.</p>
            <% } else { %>
              <div style="display:flex; flex-direction:column; gap:6px;">
                <% activeSessions.forEach(function(s) { %>
                  <div style="display:flex; align-items:center; gap:8px; padding:8px 10px; background:var(--surface2); border-radius:8px; border:1px solid var(--border);">
                    <span style="font-weight:600; flex:1; font-size:0.88rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= s.employeeName %></span>
                    <span class="shift-badge" style="font-size:0.72rem; padding:2px 8px; flex-shrink:0;"><%= s.shiftName %></span>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="panel" style="margin-bottom:14px;">
          <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--muted); margin-bottom:10px;">Quick Actions</div>
          <div style="display:flex; flex-direction:column; gap:7px;">
            <a href="<%= adminUrl('/live') %>" class="btn btn-ghost btn-full" style="justify-content:flex-start; gap:10px;">🟢&nbsp; Live View</a>
            <a href="<%= adminUrl('/schedule') %>" class="btn btn-ghost btn-full" style="justify-content:flex-start; gap:10px;">🗓️&nbsp; Schedule</a>
            <a href="<%= adminUrl('/build') %>" class="btn btn-ghost btn-full" style="justify-content:flex-start; gap:10px;">📋&nbsp; Build Checklists</a>
            <a href="<%= adminUrl('/employees') %>" class="btn btn-ghost btn-full" style="justify-content:flex-start; gap:10px;">👥&nbsp; Manage Staff</a>
            <a href="<%= adminUrl('/reports') %>" class="btn btn-ghost btn-full" style="justify-content:flex-start; gap:10px;">📊&nbsp; View Reports</a>
          </div>
        </div>

        <!-- Store Stats -->
        <div class="panel">
          <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--muted); margin-bottom:10px;">Store Stats</div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <div style="text-align:center; padding:10px 8px; background:var(--surface2); border-radius:8px; border:1px solid var(--border);">
              <div style="font-size:1.7rem; font-weight:800; color:var(--brand); line-height:1.1;"><%= employeeCount %></div>
              <div style="font-size:0.72rem; color:var(--muted); margin-top:3px;">Staff</div>
            </div>
            <div style="text-align:center; padding:10px 8px; background:var(--surface2); border-radius:8px; border:1px solid var(--border);">
              <div style="font-size:1.7rem; font-weight:800; color:var(--brand); line-height:1.1;"><%= shiftCount %></div>
              <div style="font-size:0.72rem; color:var(--muted); margin-top:3px;">Shifts</div>
            </div>
            <div style="text-align:center; padding:10px 8px; background:var(--surface2); border-radius:8px; border:1px solid var(--border);">
              <div style="font-size:1.7rem; font-weight:800; color:var(--brand); line-height:1.1;"><%= taskCount %></div>
              <div style="font-size:0.72rem; color:var(--muted); margin-top:3px;">Tasks</div>
            </div>
            <div style="text-align:center; padding:10px 8px; background:var(--surface2); border-radius:8px; border:1px solid var(--border);">
              <div style="font-size:1.7rem; font-weight:800; color:<%= customCount > 0 ? '#f59e0b' : 'var(--muted)' %>; line-height:1.1;"><%= customCount %></div>
              <div style="font-size:0.72rem; color:var(--muted); margin-top:3px;">Extra today</div>
            </div>
          </div>
        </div>

      </div><!-- /sidebar column -->

    </div><!-- /dash-grid -->
  </div>

  <script>
    var POLL_SECONDS = 15;

    // ── Notes panel toggle (persisted per browser) ──────────────────
    var NOTES_KEY = 'dash_notes_collapsed';
    var notesCollapsed = localStorage.getItem(NOTES_KEY) === '1';

    function applyNotesState(animate) {
      var body = document.getElementById('notesBody');
      var chevron = document.getElementById('notesChevron');
      if (!body) return;
      if (notesCollapsed) {
        body.style.maxHeight = '0';
        body.style.overflow = 'hidden';
        if (chevron) chevron.style.transform = 'rotate(180deg)';
      } else {
        body.style.maxHeight = body.scrollHeight + 'px';
        body.style.overflow = '';
        if (chevron) chevron.style.transform = 'rotate(0deg)';
      }
    }

    function toggleNotes() {
      notesCollapsed = !notesCollapsed;
      localStorage.setItem(NOTES_KEY, notesCollapsed ? '1' : '0');
      var body = document.getElementById('notesBody');
      if (body) body.style.transition = 'max-height 0.25s ease';
      applyNotesState(true);
    }

    // Apply on load without animation
    (function() {
      var body = document.getElementById('notesBody');
      if (body) body.style.transition = 'none';
      applyNotesState(false);
    })();

    function escHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    var badgeEl = document.getElementById('liveBadge');
    var badgeLabelEl = document.getElementById('liveBadgeLabel');

    function setBadgeUpdating() {
      if (!badgeEl) return;
      badgeEl.classList.add('updating');
      if (badgeLabelEl) badgeLabelEl.textContent = 'Updating…';
    }

    function setBadgeLive() {
      if (!badgeEl) return;
      badgeEl.classList.remove('updating');
      if (badgeLabelEl) badgeLabelEl.textContent = 'LIVE';
      badgeEl.classList.remove('flash');
      void badgeEl.offsetWidth;
      badgeEl.classList.add('flash');
    }

    function updateActiveSessions(sessions) {
      var el = document.getElementById('activeSessionsList');
      if (!el) return;
      if (sessions.length === 0) {
        el.innerHTML = '<p style="color:var(--muted); font-size:0.85rem; margin:0;">No staff on shift.</p>';
        return;
      }
      var html = '<div style="display:flex; flex-direction:column; gap:6px;">';
      sessions.forEach(function(s) {
        html += '<div style="display:flex; align-items:center; gap:8px; padding:8px 10px; background:var(--surface2); border-radius:8px; border:1px solid var(--border);">'
          + '<span style="font-weight:600; flex:1; font-size:0.88rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">' + escHtml(s.employeeName) + '</span>'
          + '<span class="shift-badge" style="font-size:0.72rem; padding:2px 8px; flex-shrink:0;">' + escHtml(s.shiftName) + '</span>'
          + '</div>';
      });
      html += '</div>';
      el.innerHTML = html;
    }

    function updateShiftPanels(shiftData) {
      shiftData.forEach(function(sd) {
        var panel = document.querySelector('[data-shift-id="' + sd.shift.id + '"]');
        if (!panel) return;
        var counterEl = panel.querySelector('[data-role="counter"]');
        var progressEl = panel.querySelector('[data-role="progress"]');
        if (sd.total > 0) {
          var pct = Math.round(sd.done / sd.total * 100);
          if (counterEl) counterEl.textContent = sd.done + '/' + sd.total;
          if (progressEl) progressEl.style.width = pct + '%';
        }
      });
    }

    async function poll() {
      setBadgeUpdating();
      try {
        var res = await fetch('<%= adminUrl('/live/data') %>');
        if (!res.ok) { setBadgeLive(); return; }
        var data = await res.json();
        updateShiftPanels(data.shiftData);
        if (data.activeSessions) updateActiveSessions(data.activeSessions);
        setBadgeLive();
      } catch (_) {
        setBadgeLive();
      }
    }

    var seconds = POLL_SECONDS;
    var countdownEl = document.getElementById('refreshCountdown');

    function tick() {
      if (countdownEl) countdownEl.textContent = 'Updates in ' + seconds + 's';
      if (seconds === 0) { seconds = POLL_SECONDS; poll(); }
      else { seconds--; }
      setTimeout(tick, 1000);
    }

    tick();
  </script>
</body>
</html>
