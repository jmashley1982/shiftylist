<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Shift Templates</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'shifts' }) %>
  <div class="main-content">
    <div class="page-header" style="margin-top:12px;">
      <h1>Shift Templates</h1>
      <p>Define which tasks belong to each shift type</p>
    </div>

    <div class="panel">
      <div class="panel-header"><h2>New Shift Type</h2></div>
      <form method="POST" action="/admin/shifts/add" class="form-stack">
        <div class="form-group">
          <label>Shift Name</label>
          <input type="text" name="name" placeholder="e.g. Open, Mid, Close" required>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Create Shift</button>
      </form>
    </div>

    <% shifts.forEach(function(shift) {
      const myTasks = shiftTasks.filter(function(st) { return st.shift_id === shift.id; });
    %>
      <div class="panel">
        <div class="panel-header" style="display:flex; align-items:center; justify-content:space-between;">
          <h2><span class="shift-badge" style="font-size:0.9rem;"><%= shift.name %></span></h2>
          <span style="color:var(--muted); font-size:0.82rem;"><%= myTasks.length %> tasks</span>
        </div>

        <form method="POST" action="/admin/shifts/<%= shift.id %>/add-task" style="display:flex; gap:8px; margin-bottom:12px;">
          <select name="taskId" required style="flex:1;">
            <option value="">Add task…</option>
            <% tasks.forEach(function(t) { %>
              <option value="<%= t.id %>"><%= t.name %></option>
            <% }); %>
          </select>
          <button type="submit" class="btn btn-primary btn-sm">Add</button>
        </form>

        <% if (myTasks.length > 0) { %>
          <div style="display:flex; flex-direction:column; gap:8px;">
            <% myTasks.forEach(function(task, idx) { %>
              <div style="display:flex; align-items:center; gap:8px; padding:8px 0; border-bottom:1px solid var(--border);">
                <span style="color:var(--muted); font-size:0.78rem; font-weight:700; min-width:24px;">#<%= task.display_order %></span>
                <span style="flex:1; font-size:0.9rem;"><%= task.task_name %></span>
                <div style="display:flex; gap:4px;">
                  <% if (idx > 0) { %>
                    <form method="POST" action="/admin/shifts/<%= shift.id %>/move-task/<%= task.id %>" style="display:inline;">
                      <input type="hidden" name="direction" value="up">
                      <button type="submit" class="btn btn-ghost btn-sm">↑</button>
                    </form>
                  <% } %>
                  <% if (idx < myTasks.length - 1) { %>
                    <form method="POST" action="/admin/shifts/<%= shift.id %>/move-task/<%= task.id %>" style="display:inline;">
                      <input type="hidden" name="direction" value="down">
                      <button type="submit" class="btn btn-ghost btn-sm">↓</button>
                    </form>
                  <% } %>
                  <form method="POST" action="/admin/shifts/<%= shift.id %>/remove-task/<%= task.id %>" style="display:inline;" onsubmit="return confirm('Remove this task from <%= shift.name %>?')">
                    <button type="submit" class="btn btn-danger btn-sm">✕</button>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p style="color:var(--muted); font-size:0.88rem;">No tasks assigned yet.</p>
        <% } %>
      </div>
    <% }); %>
  </div>
</body>
</html>
