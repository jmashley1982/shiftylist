<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Shifts</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'shifts' }) %>
  <div class="main-content">
    <div class="page-header" style="margin-top:12px;">
      <h1>Shifts</h1>
      <p>Build each shift's checklist. It's live for staff the moment you add a task.</p>
    </div>

    <% if (shifts.length === 0) { %>
      <div class="panel">
        <div class="panel-header"><h2>Create your first shift</h2></div>
        <form method="POST" action="/admin/shifts/add" class="form-stack">
          <div class="form-group">
            <label>Shift name</label>
            <input type="text" name="name" placeholder="e.g. Open, Mid, Close" required autofocus>
          </div>
          <button type="submit" class="btn btn-primary btn-full">Create shift</button>
        </form>
      </div>
    <% } else { %>

      <datalist id="taskSuggestions">
        <% allTasks.forEach(function(t) { %><option value="<%= t.name %>"></option><% }); %>
      </datalist>

      <!-- ─────────────────── ADD A TASK ─────────────────── -->
      <div class="panel" style="margin-bottom:16px;">
        <div class="panel-header"><h2>Add a Task</h2></div>
        <form method="POST" action="/admin/shifts/add-task" id="addTaskForm">

          <div style="margin-bottom:12px;">
            <input type="text" name="name" list="taskSuggestions"
                   placeholder="Type a task name…" required autocomplete="off"
                   style="width:100%; font-size:0.95rem; padding:9px 12px; border:1px solid var(--border); border-radius:8px; background:var(--bg); color:var(--text);">
          </div>

          <div style="display:flex; gap:16px; flex-wrap:wrap; margin-bottom:12px;">
            <label style="display:flex; align-items:center; gap:7px; cursor:pointer; font-size:0.9rem;">
              <input type="radio" name="type" value="daily" id="typeDaily" checked>
              <span><strong>Daily</strong> — always on the standing list</span>
            </label>
            <label style="display:flex; align-items:center; gap:7px; cursor:pointer; font-size:0.9rem;">
              <input type="radio" name="type" value="oneoff" id="typeOneoff">
              <span><strong>One-off</strong> — appears on a specific date only</span>
            </label>
          </div>

          <div style="margin-bottom:12px;">
            <div style="font-size:0.78rem; font-weight:700; color:var(--muted); letter-spacing:0.05em; text-transform:uppercase; margin-bottom:7px;">Shift(s)</div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
              <% shifts.forEach(function(s) { %>
                <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-size:0.9rem; background:var(--bg); border:1px solid var(--border); border-radius:7px; padding:6px 12px;">
                  <input type="checkbox" name="shiftIds" value="<%= s.id %>"> <%= s.name %>
                </label>
              <% }); %>
            </div>
          </div>

          <!-- Date selector — shown only for One-off -->
          <div id="dateSelector" style="display:none; margin-bottom:12px;">
            <div style="font-size:0.78rem; font-weight:700; color:var(--muted); letter-spacing:0.05em; text-transform:uppercase; margin-bottom:7px;">Date</div>
            <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
              <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-size:0.9rem;">
                <input type="radio" name="dateChoice" value="today" id="dateToday" checked> Today's list(s)
              </label>
              <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-size:0.9rem;">
                <input type="radio" name="dateChoice" value="pick" id="datePick"> Pick a date
              </label>
              <input type="date" name="date" id="addTaskDate" value="<%= today %>"
                     style="display:none; font-size:0.9rem; padding:5px 8px; border:1px solid var(--border); border-radius:6px; background:var(--bg); color:var(--text);">
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-full">Add Task</button>
        </form>
      </div>

      <!-- ─────────────────── SHIFT PICKER ─────────────────── -->
      <% if (selectedShift) { %>
        <div style="display:flex; gap:8px; margin-bottom:14px; flex-wrap:wrap;">
          <% shifts.forEach(function(s) { %>
            <a href="/admin/shifts?shift=<%= s.id %>"
               class="btn btn-sm <%= s.id === selectedShift.id ? 'btn-primary' : 'btn-ghost' %>"
               style="flex:1; min-width:80px;"><%= s.name %></a>
          <% }); %>
        </div>

        <!-- ─────────────────── STANDING LIST ─────────────────── -->
        <div class="panel" style="margin-bottom:14px;">
          <div class="panel-header">
            <h2><span class="shift-badge"><%= selectedShift.name %></span> standing list</h2>
            <span style="color:var(--muted); font-size:0.82rem;" data-task-count><%= standingTasks.length %> task<%= standingTasks.length === 1 ? '' : 's' %></span>
          </div>

          <div class="alert alert-success" style="margin-bottom:12px; font-size:0.83rem;">
            Always live — staff on the <%= selectedShift.name %> shift see this checklist every day.
          </div>

          <% if (standingTasks.length > 0) { %>
            <div class="task-edit-list"
                 data-reorder-url="/admin/shifts/<%= selectedShift.id %>/standing/reorder">
              <% standingTasks.forEach(function(task, idx) { %>
                <div class="task-row" draggable="true" data-id="<%= task.id %>">
                  <span class="drag-handle" title="Drag to reorder">⠿</span>
                  <span class="task-num"><%= idx + 1 %>.</span>
                  <span class="task-edit-name" contenteditable="true" spellcheck="false"
                        data-rename-url="/admin/shifts/<%= selectedShift.id %>/standing/rename/<%= task.id %>"><%= task.task_name %></span>
                  <form method="POST" action="/admin/shifts/<%= selectedShift.id %>/standing/remove/<%= task.id %>"
                        onsubmit="return confirm('Remove this task from the standing list?')" style="flex-shrink:0;">
                    <button type="submit" class="btn btn-danger btn-sm">✕</button>
                  </form>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p style="color:var(--muted); font-size:0.88rem;">
              No tasks yet. Use "Add a Task" above to build this shift's checklist.
            </p>
          <% } %>
        </div>

        <!-- ─────────────────── EXTRA TASKS (browseable by date) ─────────────────── -->
        <div class="panel" style="margin-bottom:14px;">
          <div class="panel-header">
            <h2 style="font-size:1rem;">One-off extras · <span class="shift-badge" style="font-size:0.78rem;"><%= selectedShift.name %></span></h2>
          </div>

          <!-- Date browser -->
          <form method="GET" action="/admin/shifts" id="extraDateForm"
                style="display:flex; align-items:center; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
            <input type="hidden" name="shift" value="<%= selectedShift.id %>">
            <label style="font-size:0.83rem; color:var(--muted); white-space:nowrap;">Browse date:</label>
            <input type="date" name="extraDate" id="extraDatePicker" value="<%= extraDate %>"
                   style="font-size:0.9rem; padding:5px 8px; border:1px solid var(--border); border-radius:6px; background:var(--bg); color:var(--text);">
            <button type="submit" class="btn btn-sm btn-ghost">Go</button>
            <% if (extraDate !== today) { %>
              <a href="/admin/shifts?shift=<%= selectedShift.id %>" class="btn btn-sm btn-ghost" style="font-size:0.8rem;">← Today</a>
            <% } %>
            <span style="font-size:0.8rem; color:var(--muted);">
              <%= extraDate === today ? 'Showing today\'s extras' : 'Showing extras for ' + formatDateDisplay(extraDate) %>
            </span>
          </form>

          <% if (extraTasks.length > 0) { %>
            <div style="display:flex; flex-direction:column; gap:4px;">
              <% extraTasks.forEach(function(task) { %>
                <div class="extra-task-row" style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border);">
                  <span class="extra-task-name" contenteditable="true" spellcheck="false"
                        data-rename-url="/admin/shifts/<%= selectedShift.id %>/day/<%= extraDate %>/rename-extra/<%= task.id %>"
                        style="flex:1; font-size:0.9rem; outline:none; border-radius:4px; padding:2px 4px;"
                        ><%= task.task_name %></span>
                  <form method="POST" action="/admin/shifts/<%= selectedShift.id %>/day/<%= extraDate %>/remove-extra/<%= task.id %>"
                        onsubmit="return confirm('Remove this extra task?')" style="flex-shrink:0;">
                    <button type="submit" class="btn btn-danger btn-sm">✕</button>
                  </form>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p style="color:var(--muted); font-size:0.88rem; margin:0;">
              No one-off extras for this date.
            </p>
          <% } %>
        </div>
      <% } %>

      <!-- ─────────────────── MANAGE SHIFTS ─────────────────── -->
      <div class="panel">
        <div class="panel-header"><h2 style="font-size:1rem;">Manage shifts</h2></div>
        <form method="POST" action="/admin/shifts/add" style="display:flex; gap:8px; margin-bottom:12px;">
          <input type="text" name="name" placeholder="New shift name…" required style="flex:1;">
          <button type="submit" class="btn btn-primary btn-sm">Add</button>
        </form>
        <div style="display:flex; flex-direction:column; gap:6px;">
          <% shifts.forEach(function(s) { %>
            <div style="display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid var(--border);">
              <span style="flex:1; font-size:0.9rem;"><%= s.name %></span>
              <form method="POST" action="/admin/shifts/delete/<%= s.id %>" onsubmit="return confirm('Delete the <%= s.name %> shift and its entire checklist?')">
                <button type="submit" class="btn btn-danger btn-sm">✕</button>
              </form>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <div id="saveToast" class="save-toast toast-hidden" aria-live="polite"></div>

  <script>
    (function () {
      // ── Add a Task form: show/hide date selector + validation ─────────────────
      var typeRadios = document.querySelectorAll('input[name="type"]');
      var dateSelector = document.getElementById('dateSelector');
      var dateChoiceRadios = document.querySelectorAll('input[name="dateChoice"]');
      var addTaskDate = document.getElementById('addTaskDate');
      var addForm = document.getElementById('addTaskForm');
      var todayStr = '<%= today %>';

      typeRadios.forEach(function(radio) {
        radio.addEventListener('change', function() {
          if (dateSelector) dateSelector.style.display = this.value === 'oneoff' ? 'block' : 'none';
        });
      });

      dateChoiceRadios.forEach(function(radio) {
        radio.addEventListener('change', function() {
          if (!addTaskDate) return;
          if (this.value === 'today') {
            addTaskDate.value = todayStr;
            addTaskDate.style.display = 'none';
          } else {
            addTaskDate.style.display = 'inline-block';
          }
        });
      });

      if (addForm) {
        addForm.addEventListener('submit', function(e) {
          var checked = addForm.querySelectorAll('input[name="shiftIds"]:checked');
          if (checked.length === 0) {
            e.preventDefault();
            alert('Please select at least one shift.');
          }
        });
      }

      // ── Unsaved-edit guard ──────────────────────────────────────────────────
      var dirtyField = null;

      function markDirty(span) {
        dirtyField = span;
        span.classList.add('task-edit-name--dirty');
      }

      function clearDirty(span) {
        if (dirtyField === span) dirtyField = null;
        span.classList.remove('task-edit-name--dirty');
      }

      window.addEventListener('beforeunload', function(e) {
        if (dirtyField) { e.preventDefault(); e.returnValue = ''; }
      });

      // ── Feedback helpers ────────────────────────────────────────────────────
      var toastTimer = null;
      function showToast(msg, isError) {
        var toast = document.getElementById('saveToast');
        if (!toast) return;
        toast.textContent = msg;
        toast.className = 'save-toast' + (isError ? ' toast-error' : '');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function() { toast.classList.add('toast-hidden'); }, 3000);
      }

      function flashRow(rowEl) {
        if (!rowEl) return;
        rowEl.classList.remove('row-saved');
        void rowEl.offsetWidth;
        rowEl.classList.add('row-saved');
        setTimeout(function() { rowEl.classList.remove('row-saved'); }, 1200);
      }

      function flashList(listEl) {
        listEl.classList.remove('list-saved');
        void listEl.offsetWidth;
        listEl.classList.add('list-saved');
        setTimeout(function() { listEl.classList.remove('list-saved'); }, 1200);
      }

      // ── Helpers ─────────────────────────────────────────────────────────────
      function refreshNums(list) {
        list.querySelectorAll('.task-row').forEach(function(row, i) {
          var n = row.querySelector('.task-num');
          if (n) n.textContent = (i + 1) + '.';
        });
      }

      function saveOrder(list, url) {
        refreshNums(list);
        var ids = Array.from(list.querySelectorAll('.task-row')).map(function(r) {
          return Number(r.dataset.id);
        });
        fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: ids }),
        }).then(function(r) {
          if (r.ok) { flashList(list); }
          else { showToast('Failed to save order — try again', true); }
        }).catch(function() { showToast('Failed to save order — check your connection', true); });
      }

      // ── Inline edit ─────────────────────────────────────────────────────────
      function initEditable(span) {
        var original = span.textContent.trim();
        var row = span.closest('[data-id]');

        span.addEventListener('focus', function() {
          if (row) row.setAttribute('draggable', 'false');
          var range = document.createRange();
          var sel = window.getSelection();
          range.selectNodeContents(span);
          range.collapse(false);
          sel.removeAllRanges();
          sel.addRange(range);
        });

        span.addEventListener('input', function() { markDirty(span); });

        span.addEventListener('blur', function() {
          if (row) row.setAttribute('draggable', 'true');
          var val = span.textContent.trim();
          if (!val) { span.textContent = original; clearDirty(span); return; }
          if (val === original) { clearDirty(span); return; }
          fetch(span.dataset.renameUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: val }),
          }).then(function(r) {
            if (r.ok) { original = val; clearDirty(span); flashRow(row); }
            else { span.textContent = original; clearDirty(span); showToast('Failed to rename — try again', true); }
          }).catch(function() { span.textContent = original; clearDirty(span); showToast('Failed to rename — check your connection', true); });
        });

        span.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') { e.preventDefault(); span.blur(); }
          if (e.key === 'Escape') { span.textContent = original; clearDirty(span); span.blur(); }
        });

        span.addEventListener('paste', function(e) {
          e.preventDefault();
          var text = e.clipboardData.getData('text/plain').replace(/\n/g, ' ');
          document.execCommand('insertText', false, text);
        });
      }

      // ── Desktop drag ────────────────────────────────────────────────────────
      function initDragList(list) {
        var url = list.dataset.reorderUrl;
        var dragging = null;
        var overEl = null;

        list.addEventListener('dragstart', function(e) {
          dragging = e.target.closest('.task-row');
          if (!dragging) return;
          e.dataTransfer.effectAllowed = 'move';
          setTimeout(function() { if (dragging) dragging.classList.add('is-dragging'); }, 0);
        });

        list.addEventListener('dragend', function() {
          if (dragging) dragging.classList.remove('is-dragging');
          if (overEl) { overEl.classList.remove('drag-over-top', 'drag-over-bottom'); }
          dragging = null;
          overEl = null;
        });

        list.addEventListener('dragover', function(e) {
          e.preventDefault();
          var target = e.target.closest('.task-row');
          if (!target || target === dragging) return;
          if (overEl && overEl !== target) overEl.classList.remove('drag-over-top', 'drag-over-bottom');
          overEl = target;
          var rect = target.getBoundingClientRect();
          if (e.clientY < rect.top + rect.height / 2) {
            target.classList.add('drag-over-top'); target.classList.remove('drag-over-bottom');
          } else {
            target.classList.add('drag-over-bottom'); target.classList.remove('drag-over-top');
          }
        });

        list.addEventListener('dragleave', function(e) {
          if (!list.contains(e.relatedTarget) && overEl) {
            overEl.classList.remove('drag-over-top', 'drag-over-bottom');
            overEl = null;
          }
        });

        list.addEventListener('drop', function(e) {
          e.preventDefault();
          var target = e.target.closest('.task-row');
          if (overEl) overEl.classList.remove('drag-over-top', 'drag-over-bottom');
          if (!target || target === dragging || !dragging) return;
          var rect = target.getBoundingClientRect();
          var before = e.clientY < rect.top + rect.height / 2;
          list.insertBefore(dragging, before ? target : target.nextSibling);
          dragging.classList.remove('is-dragging');
          dragging = null;
          overEl = null;
          saveOrder(list, url);
        });

        initTouchDrag(list, url);
      }

      // ── Touch drag ───────────────────────────────────────────────────────────
      function initTouchDrag(list, url) {
        var dragEl = null;

        function onMove(e) {
          if (!dragEl) return;
          e.preventDefault();
          var touch = e.touches[0];
          dragEl.style.visibility = 'hidden';
          var below = document.elementFromPoint(touch.clientX, touch.clientY);
          dragEl.style.visibility = '';
          if (!below) return;
          var target = below.closest ? below.closest('.task-row') : null;
          if (!target || target === dragEl || !list.contains(target)) return;
          var rect = target.getBoundingClientRect();
          var before = touch.clientY < rect.top + rect.height / 2;
          list.insertBefore(dragEl, before ? target : target.nextSibling);
          refreshNums(list);
        }

        function onEnd() {
          if (!dragEl) return;
          dragEl.classList.remove('is-dragging');
          document.removeEventListener('touchmove', onMove);
          document.removeEventListener('touchend', onEnd);
          document.removeEventListener('touchcancel', onEnd);
          saveOrder(list, url);
          dragEl = null;
        }

        list.querySelectorAll('.drag-handle').forEach(function(handle) {
          handle.addEventListener('touchstart', function() {
            dragEl = handle.closest('.task-row');
            if (!dragEl) return;
            dragEl.classList.add('is-dragging');
            document.addEventListener('touchmove', onMove, { passive: false });
            document.addEventListener('touchend', onEnd, { passive: true });
            document.addEventListener('touchcancel', onEnd, { passive: true });
          }, { passive: true });
        });
      }

      // ── Init ────────────────────────────────────────────────────────────────
      document.querySelectorAll('.task-edit-list').forEach(function(list) {
        initDragList(list);
        list.querySelectorAll('.task-edit-name').forEach(initEditable);
      });

      // ── Extra task inline rename ─────────────────────────────────────────────
      document.querySelectorAll('.extra-task-name').forEach(function(span) {
        var original = span.textContent.trim();
        var row = span.closest('.extra-task-row');

        span.addEventListener('focus', function() {
          span.style.background = 'var(--bg)';
          span.style.boxShadow = '0 0 0 2px var(--teal)';
          var range = document.createRange();
          var sel = window.getSelection();
          range.selectNodeContents(span);
          range.collapse(false);
          sel.removeAllRanges();
          sel.addRange(range);
        });

        span.addEventListener('blur', function() {
          span.style.boxShadow = '';
          span.style.background = '';
          var val = span.textContent.trim();
          if (!val || val === original) { span.textContent = original; return; }
          fetch(span.dataset.renameUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: val }),
          }).then(function(r) {
            if (r.ok) { original = val; if (row) flashRow(row); }
            else { span.textContent = original; showToast('Failed to rename — try again', true); }
          }).catch(function() { span.textContent = original; showToast('Failed to rename — check your connection', true); });
        });

        span.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') { e.preventDefault(); span.blur(); }
          if (e.key === 'Escape') { span.textContent = original; span.blur(); }
        });

        span.addEventListener('paste', function(e) {
          e.preventDefault();
          var text = e.clipboardData.getData('text/plain').replace(/\n/g, ' ');
          document.execCommand('insertText', false, text);
        });
      });

      // ── Extra date picker: auto-submit on change ─────────────────────────────
      var extraDatePicker = document.getElementById('extraDatePicker');
      var extraDateForm = document.getElementById('extraDateForm');
      if (extraDatePicker && extraDateForm) {
        extraDatePicker.addEventListener('change', function() {
          extraDateForm.submit();
        });
      }
    })();
  </script>
</body>
</html>
