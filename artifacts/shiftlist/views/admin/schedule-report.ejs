<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Accountability Report</title>
  <link rel="stylesheet" href="<%= staffUrl('/style.css') %>">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'schedule' }) %>
  <div class="main-content">
    <div class="page-header" style="margin-top:12px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
      <div>
        <h1>Accountability Report</h1>
        <p>Scheduled shifts, <%= formatDateDisplay(windowStart) %> – <%= formatDateDisplay(today) %></p>
      </div>
      <a href="<%= adminUrl('/schedule') %>" class="btn btn-ghost btn-sm">← Schedule</a>
    </div>

    <% if (summary.length === 0) { %>
      <div class="alert alert-info">
        No scheduled shifts in this window yet — upload a Homebase export on the
        <a href="<%= adminUrl('/schedule') %>" style="color:inherit; text-decoration:underline;">Schedule</a> page.
      </div>
    <% } else { %>

      <div class="panel" style="margin-bottom:16px;">
        <div class="panel-header"><h2 style="font-size:1rem;">By employee</h2></div>
        <div style="display:flex; flex-direction:column; gap:6px;">
          <% summary.forEach(function(s) { %>
            <div style="display:flex; align-items:center; gap:10px; padding:8px 10px; background:var(--surface2); border-radius:8px; border:1px solid var(--border); flex-wrap:wrap;">
              <span style="font-weight:700; flex:1; min-width:120px;"><%= s.employeeName %></span>
              <span style="font-size:0.8rem; color:var(--muted);"><%= s.scheduled %> scheduled</span>
              <span style="font-size:0.8rem; color:var(--brand);"><%= s.submitted %> submitted</span>
              <% if (s.openedNotSubmitted > 0) { %>
                <span style="font-size:0.8rem; font-weight:700; color:#f59e0b;"><%= s.openedNotSubmitted %> opened, no submit</span>
              <% } %>
              <% if (s.neverOpened > 0) { %>
                <span style="font-size:0.8rem; font-weight:700; color:#ef4444;"><%= s.neverOpened %> never opened</span>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>

      <% var anyMisses = summary.some(function(s) { return s.misses.length > 0; }); %>
      <% if (anyMisses) { %>
        <div class="panel">
          <div class="panel-header"><h2 style="font-size:1rem;">Missed shifts</h2></div>
          <div style="display:flex; flex-direction:column; gap:0;">
            <% summary.forEach(function(s) { %>
              <% s.misses.forEach(function(m) { %>
                <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border); font-size:0.88rem; flex-wrap:wrap;">
                  <span style="font-weight:600; min-width:120px;"><%= s.employeeName %></span>
                  <span style="color:var(--muted);"><%= formatDateDisplay(m.date) %></span>
                  <span class="shift-badge" style="font-size:0.72rem;"><%= m.shiftName %></span>
                  <span style="margin-left:auto; font-weight:700; font-size:0.78rem; padding:2px 9px; border-radius:20px; white-space:nowrap;
                    <%= m.status === 'never_opened'
                      ? 'color:#ef4444; background:rgba(239,68,68,.12); border:1px solid rgba(239,68,68,.25);'
                      : 'color:#f59e0b; background:rgba(245,158,11,.12); border:1px solid rgba(245,158,11,.25);' %>">
                    <%= m.status === 'never_opened' ? 'Never opened' : 'Opened, no submit' %>
                  </span>
                </div>
              <% }); %>
            <% }); %>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-success">Everyone scheduled opened and submitted their shift. 🎉</div>
      <% } %>

    <% } %>
  </div>
</body>
</html>
