<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Live Status</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'live' }) %>
  <div class="main-content">
    <div class="page-header" style="margin-top:12px; display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:8px;">
      <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
        <h1 style="margin:0;">Live Status</h1>
        <span id="liveBadge" class="live-badge"><span class="live-badge-dot"></span><span id="liveBadgeLabel">LIVE</span></span>
      </div>
      <div style="display:flex; flex-direction:column; align-items:flex-end; gap:2px;">
        <p style="margin:0; font-size:0.85rem; color:var(--muted);"><%= formatDateDisplay(today) %> — real-time completion view</p>
        <span id="refreshCountdown" style="font-size:0.8rem; color:var(--muted);"></span>
      </div>
    </div>

    <% if (shiftData.length === 0) { %>
      <div class="panel">
        <p style="color:var(--muted); font-size:0.9rem;">No shifts set up yet. <a href="/admin/shifts">Create one</a>.</p>
      </div>
    <% } %>

    <div style="display:grid; gap:16px;">
      <% shiftData.forEach(function(sd) { %>
        <div class="panel" data-shift-id="<%= sd.shift.id %>">
          <div class="panel-header" style="margin-bottom:12px;">
            <h2><span class="shift-badge"><%= sd.shift.name %></span></h2>
            <% if (sd.total > 0) { %>
              <span data-role="counter" style="font-size:0.9rem; color:var(--muted);"><%= sd.done %>/<%= sd.total %> done</span>
            <% } %>
          </div>

          <% if (sd.total === 0) { %>
            <p style="color:var(--muted); font-size:0.88rem;">No tasks set up for this shift.</p>
          <% } else { %>
            <% var pct = Math.round(sd.done / sd.total * 100); %>
            <div class="progress-bar-wrap" style="margin-bottom:14px;">
              <div class="progress-bar-fill" style="width:<%= pct %>%"></div>
            </div>

            <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:6px;">
              <% var firstExtra = true; %>
              <% sd.tasks.forEach(function(task) { %>
                <% if (task.isExtra && firstExtra) { firstExtra = false; %>
                  <li style="list-style:none; padding:6px 0 2px; text-align:center;">
                    <span style="font-size:0.72rem; font-weight:700; color:var(--muted); letter-spacing:0.06em; text-transform:uppercase;">— Today only —</span>
                  </li>
                <% } %>
                <li data-task-name="<%= task.name %>" style="display:flex; align-items:center; gap:10px; padding:9px 12px; background:var(--bg); border-radius:8px; border:1px solid var(--border);">
                  <% if (task.completed) { %>
                    <span data-role="check-icon" style="width:22px; height:22px; border-radius:50%; background:var(--teal); display:flex; align-items:center; justify-content:center; font-size:0.78rem; color:#fff; flex-shrink:0; font-weight:700;">✓</span>
                  <% } else { %>
                    <span data-role="check-icon" style="width:22px; height:22px; border-radius:50%; border:2px solid var(--border); flex-shrink:0;"></span>
                  <% } %>
                  <span data-role="task-name" style="flex:1; font-size:0.9rem;<%= task.completed ? ' color:var(--muted); text-decoration:line-through;' : '' %>"><%= task.name %></span>
                  <% if (task.completed) { %>
                    <span data-role="task-info" style="font-size:0.78rem; color:var(--muted); white-space:nowrap; text-align:right;">
                      <%= task.completedBy %>
                      <% if (task.completedAtIso) { %>
                        &middot; <span class="live-ts" data-ts="<%= task.completedAtIso %>"></span>
                      <% } %>
                    </span>
                  <% } else { %>
                    <span data-role="task-info" style="font-size:0.75rem; color:var(--muted); opacity:0.6;">pending</span>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>

  <script>
    var POLL_SECONDS = 10;

    function fmtTime(iso) {
      return new Date(iso).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    }

    // Format timestamps rendered server-side on initial load
    document.querySelectorAll('.live-ts').forEach(function(el) {
      var ts = el.dataset.ts;
      if (ts) el.textContent = fmtTime(ts);
    });

    function updatePanel(panelEl, sd) {
      // Progress bar
      var fill = panelEl.querySelector('.progress-bar-fill');
      if (fill && sd.total > 0) {
        fill.style.width = Math.round(sd.done / sd.total * 100) + '%';
      }

      // Counter
      var counter = panelEl.querySelector('[data-role="counter"]');
      if (counter) counter.textContent = sd.done + '/' + sd.total + ' done';

      // Task rows
      sd.tasks.forEach(function(task) {
        var li = panelEl.querySelector('[data-task-name="' + CSS.escape(task.name) + '"]');
        if (!li) return;

        var icon = li.querySelector('[data-role="check-icon"]');
        var nameEl = li.querySelector('[data-role="task-name"]');
        var infoEl = li.querySelector('[data-role="task-info"]');

        if (task.completed) {
          if (icon) {
            icon.style.cssText = 'width:22px; height:22px; border-radius:50%; background:var(--teal); display:flex; align-items:center; justify-content:center; font-size:0.78rem; color:#fff; flex-shrink:0; font-weight:700;';
            icon.textContent = '✓';
          }
          if (nameEl) {
            nameEl.style.color = 'var(--muted)';
            nameEl.style.textDecoration = 'line-through';
          }
          if (infoEl) {
            var info = task.completedBy || '';
            if (task.completedAtIso) info += ' · ' + fmtTime(task.completedAtIso);
            infoEl.style.cssText = 'font-size:0.78rem; color:var(--muted); white-space:nowrap; text-align:right;';
            infoEl.textContent = info;
          }
        } else {
          if (icon) {
            icon.style.cssText = 'width:22px; height:22px; border-radius:50%; border:2px solid var(--border); flex-shrink:0;';
            icon.textContent = '';
          }
          if (nameEl) {
            nameEl.style.color = '';
            nameEl.style.textDecoration = '';
          }
          if (infoEl) {
            infoEl.style.cssText = 'font-size:0.75rem; color:var(--muted); opacity:0.6;';
            infoEl.textContent = 'pending';
          }
        }
      });
    }

    var badgeEl = document.getElementById('liveBadge');
    var badgeLabelEl = document.getElementById('liveBadgeLabel');

    function setBadgeUpdating() {
      if (!badgeEl) return;
      badgeEl.classList.remove('flash');
      badgeEl.classList.add('updating');
      if (badgeLabelEl) badgeLabelEl.textContent = 'Updating…';
    }

    function setBadgeLive() {
      if (!badgeEl) return;
      badgeEl.classList.remove('updating');
      if (badgeLabelEl) badgeLabelEl.textContent = 'LIVE';
      // Trigger flash: remove then re-add to restart animation
      badgeEl.classList.remove('flash');
      void badgeEl.offsetWidth; // reflow
      badgeEl.classList.add('flash');
    }

    async function pollLive() {
      setBadgeUpdating();
      try {
        var res = await fetch('/admin/live/data');
        if (!res.ok) { setBadgeLive(); return; }
        var data = await res.json();
        data.shiftData.forEach(function(sd) {
          var panel = document.querySelector('[data-shift-id="' + sd.shift.id + '"]');
          if (panel) updatePanel(panel, sd);
        });
        setBadgeLive();
      } catch (_) {
        // ignore network errors — next tick will retry
        setBadgeLive();
      }
    }

    // Countdown + polling
    var seconds = POLL_SECONDS;
    var countdownEl = document.getElementById('refreshCountdown');

    function tick() {
      if (countdownEl) countdownEl.textContent = 'Updates in ' + seconds + 's';
      if (seconds === 0) {
        seconds = POLL_SECONDS;
        pollLive();
      } else {
        seconds--;
      }
      setTimeout(tick, 1000);
    }

    tick();
  </script>
</body>
</html>
