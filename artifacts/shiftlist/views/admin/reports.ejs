<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Reports</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'reports' }) %>
  <div class="main-content">
    <div class="page-header" style="margin-top:12px;">
      <h1>Reports</h1>
      <p>Submissions from the last 30 days<% if (employeeFilter) { %> &mdash; <strong><%= employeeFilter %></strong><% } %></p>
    </div>

    <% if (employeeFilter) { %>
      <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px; padding:8px 12px; background:var(--surface2); border:1px solid var(--border); border-radius:8px; font-size:0.88rem; color:var(--muted);">
        <span>Filtered to: <strong style="color:var(--text);"><%= employeeFilter %></strong></span>
        <a href="/admin/reports" style="margin-left:auto; color:var(--brand); text-decoration:none; font-size:0.82rem;">Clear filter ✕</a>
      </div>
    <% } %>

    <% if (dbError) { %>
      <div class="alert alert-error">Could not load reports. Please try refreshing the page.</div>
    <% } else if (groups.length > 0) { %>

      <% groups.forEach(function(group) { %>
        <div class="report-date-heading"><%= group.label %></div>

        <% group.shifts.forEach(function(shiftGroup) { %>
          <details class="report-shift-details">
            <summary class="report-shift-summary">
              <span class="shift-badge"><%= shiftGroup.shiftName %></span>
              <span class="report-count">
                <%= shiftGroup.items.length %> report<%= shiftGroup.items.length === 1 ? '' : 's' %>
              </span>
              <span class="report-chevron">›</span>
            </summary>

            <div class="report-submissions">
              <% shiftGroup.items.forEach(function(row) { %>
                <div class="report-card">
                  <div class="report-card-header">
                    <span class="report-employee"><%= row.employee_name || '—' %></span>
                    <span class="report-time">
                      <%= row.submitted_at ? formatLocalTime(row.submitted_at) : '—' %>
                      <% if (row.auto_submitted) { %>
                        <span style="display:inline-block; margin-left:6px; padding:1px 6px; background:#7a5c00; color:#ffd97d; border-radius:4px; font-size:0.72rem; font-weight:600; letter-spacing:0.03em; vertical-align:middle;" title="Auto-submitted by system — staff did not close their shift" aria-label="Auto-submitted">Auto</span>
                      <% } %>
                    </span>
                  </div>

                  <% if (row.task_summary) { %>
                    <div class="report-tasks">
                      <% row.task_summary.split(' | ').forEach(function(task) { %>
                        <div class="report-task-line <%= task.trim().startsWith('✓') ? 'task-done' : 'task-missed' %>">
                          <%= task.trim() %>
                        </div>
                      <% }); %>
                    </div>
                  <% } %>

                  <% if (row.notes) { %>
                    <div class="report-notes">
                      <span class="report-notes-label">Notes:</span> <%= row.notes %>
                    </div>
                  <% } %>
                </div>
              <% }); %>
            </div>
          </details>
        <% }); %>

        <div style="height:8px;"></div>
      <% }); %>

    <% } else { %>
      <div class="alert alert-info">No submissions found in the last 30 days.</div>
    <% } %>
  </div>
</body>
</html>
