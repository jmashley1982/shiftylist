<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Report Submitted</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="page-center">
    <div class="card" style="max-width:420px; text-align:center;">
      <div class="success-icon">✅</div>
      <h1>Report Submitted!</h1>
      <p class="subtitle text-center">Your shift has been logged.</p>


      <ul class="summary-list">
        <li style="font-size:0.8rem; color:var(--muted); margin-bottom:6px; font-weight:600;">
          <%= employeeName %> &nbsp;·&nbsp; <%= shift %> &nbsp;·&nbsp; <%= date %>
        </li>
        <% tasks.forEach(function(t) { %>
          <li class="summary-item">
            <span style="color:<%= t.completed ? 'var(--success)' : 'var(--danger)' %>; font-size:1rem; flex-shrink:0;">
              <%= t.completed ? '✓' : '✗' %>
            </span>
            <span style="flex:1; <% if(!t.completed){ %>color:var(--muted)<% } %>"><%= t.text %></span>
            <% if (t.completionTime) { %>
              <span style="font-size:0.75rem; color:var(--muted);"><%= t.completionTime %></span>
            <% } %>
          </li>
        <% }); %>
        <% if (notes) { %>
          <li style="padding:12px 0; border-top:1px solid var(--border); text-align:left;">
            <div style="font-size:0.75rem; font-weight:600; color:var(--text-mid); margin-bottom:4px;">Notes</div>
            <div style="font-size:0.82rem; color:var(--muted); line-height:1.5;"><%= notes %></div>
          </li>
        <% } %>
      </ul>

      <a href="/logout" class="btn btn-primary btn-full">Log Out</a>
      <div class="powered-by">
        <span>Powered by</span>
        <img src="/shiftylist-logo.png" alt="ShiftyList">
      </div>
    </div>
  </div>
</body>
</html>
