<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>My Tasks</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/admin/dashboard" class="brand">
      <img src="/vvas-logo.png" alt="VVAS">
      <img src="/shiftylist-logo.png" alt="ShiftyList" class="brand-platform-logo">
    </a>
    <div class="navbar-right">
      <span class="navbar-user"><%= employeeName %></span>
      <a href="/logout" class="btn btn-ghost btn-sm" style="min-height:36px;padding:7px 12px;">Out</a>
    </div>
  </nav>

  <div class="main-content-notabs">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; margin-top:8px;">
      <div>
        <h1 style="font-size:1.2rem;">Today's Tasks</h1>
      </div>
      <span class="shift-badge"><%= shift %></span>
    </div>

    <div class="progress-bar-wrap">
      <div class="progress-bar-fill" id="progressBar" style="width:0%"></div>
    </div>

    <ul class="task-list" id="taskList">
      <% if (extraCount > 0) { %>
        <li style="list-style:none; margin-bottom:6px;">
          <div style="display:flex; align-items:center; gap:8px; padding:8px 12px; background:rgba(56,182,160,.12); border:1px solid rgba(56,182,160,.35); border-radius:8px;">
            <span style="font-size:1rem; line-height:1;">⚡</span>
            <span style="font-size:0.78rem; font-weight:800; color:var(--brand); letter-spacing:0.07em; text-transform:uppercase;">Today only — <%= extraCount %> extra task<%= extraCount === 1 ? '' : 's' %></span>
          </div>
        </li>
      <% } %>
      <% tasks.forEach(function(task, idx) { %>
        <% if (extraCount > 0 && idx === extraCount) { %>
          <li style="list-style:none; padding:10px 0 2px; display:flex; align-items:center; gap:8px;">
            <div style="flex:1; height:1px; background:var(--border);"></div>
            <span style="font-size:0.7rem; font-weight:700; color:var(--muted); letter-spacing:0.06em; text-transform:uppercase; white-space:nowrap;">Regular tasks</span>
            <div style="flex:1; height:1px; background:var(--border);"></div>
          </li>
        <% } %>
        <li class="task-item<%= task.isExtra ? ' task-item-extra' : '' %>" id="task-<%= idx %>" onclick="toggleTask(<%= idx %>)">
          <div class="task-checkbox" id="cb-<%= idx %>"></div>
          <span class="task-text" id="text-<%= idx %>"><%= task.text %></span>
          <span class="task-window-badge" id="win-<%= idx %>"></span>
          <span class="task-time" id="time-<%= idx %>"></span>
        </li>
      <% }); %>
    </ul>

    <div style="margin-bottom:16px;">
      <label style="font-size:0.85rem; font-weight:600; color:var(--text-mid); margin-bottom:6px; display:block;">Notes</label>
      <textarea id="notes" rows="3" style="width:100%; padding:10px 12px; font-size:0.88rem; border:1px solid var(--border); border-radius:8px; resize:vertical; background:var(--bg); color:var(--text);" placeholder="Anything to note about this shift?"></textarea>
    </div>

    <div style="padding-bottom: 80px;">
      <button class="btn btn-success btn-full" id="submitBtn" onclick="submitShift()">
        Submit Shift Report
      </button>
      <p style="text-align:center; font-size:0.78rem; color:var(--muted); margin-top:8px;" id="progressText">
        0 / <%= tasks.length %> completed
      </p>
      <div class="powered-by" style="margin-top:16px;">
        <span>Powered by</span>
        <img src="/shiftylist-logo.png" alt="ShiftyList">
      </div>
    </div>
  </div>

  <!-- Incomplete task warning modal -->
  <div id="incompleteModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:100; align-items:center; justify-content:center;">
    <div style="background:var(--card); border-radius:12px; padding:24px; max-width:340px; width:90%; box-shadow:var(--shadow-lg); text-align:center; border:1px solid var(--border);">
      <div style="font-size:2rem; margin-bottom:8px;">⚠️</div>
      <h2 style="font-size:1.1rem; margin-bottom:8px;">Not all tasks completed</h2>
      <p style="font-size:0.85rem; color:var(--muted); margin-bottom:16px;">
        You have unchecked tasks. Is this correct?
      </p>
      <div style="display:flex; flex-direction:column; gap:8px;">
        <button onclick="confirmSubmit()" class="btn btn-primary btn-full">Yes, submit anyway</button>
        <button onclick="closeModal()" class="btn btn-ghost btn-full">Go back and check</button>
      </div>
      <div style="margin-top:12px;">
        <label style="font-size:0.8rem; font-weight:600; color:var(--text-mid); margin-bottom:4px; display:block;">Please leave a note:</label>
        <textarea id="modalNotes" rows="2" style="width:100%; padding:8px; font-size:0.85rem; border:1px solid var(--border); border-radius:6px; background:var(--bg); color:var(--text);" placeholder="Why weren't all tasks completed?"></textarea>
      </div>
    </div>
  </div>


  <script>
    var currentEmployee = <%- JSON.stringify(employeeName) %>;
    var serverCompletions = <%- JSON.stringify(completionMap) %>;

    // ── Progress-restored banner ───────────────────────────────────────────────
    (function() {
      var count = Object.keys(serverCompletions).length;
      if (count === 0) return;
      var banner = document.createElement('div');
      banner.id = 'restoredBanner';
      banner.style.cssText = 'display:flex; align-items:center; justify-content:space-between; gap:8px; padding:10px 14px; margin-bottom:12px; background:rgba(56,182,160,.12); border:1px solid rgba(56,182,160,.35); border-radius:8px; cursor:pointer;';
      banner.innerHTML = '<span style="font-size:0.82rem; font-weight:700; color:var(--brand);">✓ Progress restored — ' + count + ' task' + (count === 1 ? '' : 's') + ' already completed.</span>'
        + '<span style="font-size:0.75rem; color:var(--brand); opacity:0.7; flex-shrink:0;">Tap to dismiss</span>';
      banner.onclick = function() { banner.remove(); };
      var list = document.getElementById('taskList');
      if (list) list.parentNode.insertBefore(banner, list);
    })();

    // ── Toast helper ──────────────────────────────────────────────────────────
    function showToast(msg) {
      var t = document.createElement('div');
      t.textContent = msg;
      t.style.cssText = 'position:fixed; bottom:24px; left:50%; transform:translateX(-50%); background:#1e2a2a; color:#fff; padding:12px 20px; border-radius:10px; font-size:0.88rem; font-weight:600; z-index:999; box-shadow:0 4px 16px rgba(0,0,0,0.4); pointer-events:none; max-width:90vw; text-align:center;';
      document.body.appendChild(t);
      setTimeout(function() { t.remove(); }, 3500);
    }

    var taskData = <%- JSON.stringify(tasks.map(function(t){ return {
      text: t.text,
      completed: false,
      completionTime: null,
      completedByName: null,
      timeStart: t.timeStart || null,
      timeEnd: t.timeEnd || null,
      lateReason: null
    }; })) %>;

    // Pre-fill from server completions (preserves state across page loads)
    taskData.forEach(function(t) {
      var c = serverCompletions[t.text];
      if (c) {
        t.completed = true;
        t.completionTime = new Date(c.at).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
        t.completedByName = c.byName;
        t.lateReason = c.lateReason || null;
      }
    });

    // ── Time helpers ──────────────────────────────────────────────────────────
    function timeToMins(hhmm) {
      if (!hhmm) return null;
      var parts = hhmm.split(':');
      return parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
    }

    function fmt12h(hhmm) {
      if (!hhmm) return '';
      var parts = hhmm.split(':');
      var h = parseInt(parts[0], 10);
      var m = parts[1];
      var ap = h >= 12 ? 'PM' : 'AM';
      h = h % 12 || 12;
      return h + ':' + m + ' ' + ap;
    }

    // ── Render ────────────────────────────────────────────────────────────────
    function renderTask(idx) {
      var t      = taskData[idx];
      var item   = document.getElementById('task-' + idx);
      var cb     = document.getElementById('cb-' + idx);
      var timeEl = document.getElementById('time-' + idx);
      var winEl  = document.getElementById('win-' + idx);
      if (!item || !cb || !timeEl) return;

      item.classList.toggle('done', t.completed);
      cb.classList.toggle('checked', t.completed);
      cb.textContent = t.completed ? '✓' : '';

      if (t.completed) {
        var parts = [];
        if (t.completedByName && t.completedByName !== currentEmployee) parts.push(t.completedByName);
        if (t.completionTime) parts.push(t.completionTime);
        if (t.lateReason) parts.push('⚠ Late');
        timeEl.textContent = parts.join(' · ');
        if (winEl) { winEl.textContent = ''; winEl.style.display = 'none'; }
        item.classList.remove('task-soon', 'task-overdue');
      } else {
        timeEl.textContent = '';
        if (winEl) {
          winEl.style.display = (t.timeStart || t.timeEnd) ? '' : 'none';
        }
      }
    }

    function updateProgress() {
      var done = taskData.filter(function(t){ return t.completed; }).length;
      var pct  = taskData.length ? Math.round(done / taskData.length * 100) : 0;
      document.getElementById('progressBar').style.width = pct + '%';
      document.getElementById('progressText').textContent = done + ' / ' + taskData.length + ' completed';
    }

    // ── Timing state (runs every 30 s) ────────────────────────────────────────
    // Times before 6 AM (360 min) are treated as next-day to handle windows
    // that cross midnight (e.g. 10 PM–12:30 AM closing-shift tasks).
    var NEXT_DAY_BOUNDARY = 360; // 6:00 AM

    function normMins(m) {
      return (m !== null && m < NEXT_DAY_BOUNDARY) ? m + 1440 : m;
    }

    function checkTiming() {
      var now     = new Date();
      var rawNow  = now.getHours() * 60 + now.getMinutes();
      var nowMins = normMins(rawNow);

      taskData.forEach(function(t, idx) {
        if (t.completed) return;
        if (!t.timeStart && !t.timeEnd) return;

        var item  = document.getElementById('task-' + idx);
        var winEl = document.getElementById('win-' + idx);
        if (!item) return;

        var startMins = timeToMins(t.timeStart);
        var endMins   = timeToMins(t.timeEnd);
        var normStart = normMins(startMins);
        var normEnd   = normMins(endMins);

        item.classList.remove('task-soon', 'task-overdue');

        var label = '';
        if (normEnd !== null && nowMins > normEnd) {
          item.classList.add('task-overdue');
          label = (t.timeStart ? fmt12h(t.timeStart) : '') +
                  (t.timeStart && t.timeEnd ? '\u2013' : '') +
                  (t.timeEnd ? fmt12h(t.timeEnd) : '') +
                  ' \u00b7 Overdue';
        } else if (normStart !== null && nowMins >= normStart - 15 && nowMins < normStart) {
          item.classList.add('task-soon');
          var minsLeft = normStart - nowMins;
          label = 'Starts in ' + minsLeft + 'm';
        } else {
          if (t.timeStart) label += fmt12h(t.timeStart);
          if (t.timeStart && t.timeEnd) label += '\u2013';
          if (t.timeEnd) label += fmt12h(t.timeEnd);
        }

        if (winEl) winEl.textContent = label;
      });
    }

    // Init
    taskData.forEach(function(_, idx) { renderTask(idx); });
    updateProgress();
    checkTiming();
    setInterval(checkTiming, 30000);

    // ── Toggle task ───────────────────────────────────────────────────────────
    var toggling = false;

    async function toggleTask(idx) {
      if (toggling) return;
      var t = taskData[idx];
      var completing = !t.completed;

      // Auto-detect late completion — no modal, just flag it silently
      var lateReason = null;
      if (completing && t.timeEnd) {
        var now        = new Date();
        var rawNowMins = now.getHours() * 60 + now.getMinutes();
        var endMins    = timeToMins(t.timeEnd);
        if (endMins !== null && normMins(rawNowMins) > normMins(endMins)) {
          lateReason = 'completed after window';
        }
      }

      toggling = true;
      await doToggle(idx, lateReason);
    }

    async function doToggle(idx, lateReason) {
      var prev = {
        completed:      taskData[idx].completed,
        completionTime: taskData[idx].completionTime,
        completedByName: taskData[idx].completedByName,
        lateReason:     taskData[idx].lateReason,
      };
      var completing = !prev.completed;

      // Optimistic update
      taskData[idx].completed      = completing;
      taskData[idx].completionTime  = completing
        ? new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })
        : null;
      taskData[idx].completedByName = completing ? currentEmployee : null;
      taskData[idx].lateReason      = completing ? lateReason : null;

      renderTask(idx);
      updateProgress();
      if (!completing) checkTiming();

      try {
        var bodyStr = 'taskName=' + encodeURIComponent(taskData[idx].text);
        if (completing && lateReason) bodyStr += '&lateReason=' + encodeURIComponent(lateReason);
        var resp = await fetch(completing ? '/staff/complete' : '/staff/uncomplete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: bodyStr,
        });
        // Detect session expiry: fetch follows the /login redirect and lands on
        // 200 HTML. Check content-type first — if it's not JSON the session has
        // expired regardless of HTTP status code.
        var ct = resp.headers.get('content-type') || '';
        if (!ct.includes('application/json')) {
          // Session expired — keep visual state (DB is safe), redirect to login
          showToast('Session expired — logging you back in…');
          setTimeout(function() { window.location.href = '/login'; }, 1800);
          return; // finally still runs (toggling = false), page navigating away
        }
        if (!resp.ok) throw new Error('server error');
      } catch(e) {
        // Generic server error — revert optimistic update
        taskData[idx].completed      = prev.completed;
        taskData[idx].completionTime  = prev.completionTime;
        taskData[idx].completedByName = prev.completedByName;
        taskData[idx].lateReason      = prev.lateReason;
        renderTask(idx);
        updateProgress();
      } finally {
        toggling = false;
      }
    }

    // ── Submit ────────────────────────────────────────────────────────────────
    var pendingSubmission = false;

    function showModal() {
      var modal = document.getElementById('incompleteModal');
      modal.style.display = 'flex';
      var mainNotes = document.getElementById('notes').value;
      if (mainNotes) document.getElementById('modalNotes').value = mainNotes;
    }

    function closeModal() {
      document.getElementById('incompleteModal').style.display = 'none';
      pendingSubmission = false;
      var btn = document.getElementById('submitBtn');
      btn.disabled = false;
      btn.textContent = 'Submit Shift Report';
    }

    function confirmSubmit() {
      var modalNotes = document.getElementById('modalNotes').value;
      if (modalNotes) document.getElementById('notes').value = modalNotes;
      closeModal();
      doSubmit();
    }

    function submitShift() {
      var btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.textContent = 'Submitting\u2026';

      var done = taskData.filter(function(t){ return t.completed; }).length;
      if (done < taskData.length) {
        pendingSubmission = true;
        showModal();
        return;
      }

      doSubmit();
    }

    async function doSubmit() {
      var btn = document.getElementById('submitBtn');
      var notes = document.getElementById('notes').value;
      try {
        var res = await fetch('/staff/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'tasks=' + encodeURIComponent(JSON.stringify(taskData)) + '&notes=' + encodeURIComponent(notes)
        });
        // Detect session expiry: ensureStaffAuth redirects to /login, so fetch
        // follows and res.redirected is true. A direct render (success) is never
        // redirected.
        if (res.redirected) {
          showToast('Session expired \u2014 please log back in and resubmit');
          setTimeout(function() { window.location.href = '/login'; }, 2500);
          btn.disabled = false;
          btn.textContent = 'Submit Shift Report';
          return;
        }
        if (res.ok) {
          document.open(); document.write(await res.text()); document.close();
        } else {
          alert('Error submitting. Please try again.');
          btn.disabled = false;
          btn.textContent = 'Submit Shift Report';
        }
      } catch(e) {
        alert('Network error. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Submit Shift Report';
      }
    }
  </script>

  <% if (staffNotice) { %>
  <div id="noticeOverlay" style="position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,0.65); display:flex; align-items:center; justify-content:center; padding:20px;">
    <div style="background:var(--card); border-radius:18px; border:1px solid var(--border); max-width:420px; width:100%; padding:32px 28px; text-align:center; box-shadow:0 24px 64px rgba(0,0,0,0.5); animation:slideUp 0.25s ease;">
      <div style="font-size:2rem; margin-bottom:16px;">📢</div>
      <% if (staffNotice.title) { %>
        <h2 style="margin:0 0 8px; font-size:1.25rem; font-weight:800; color:var(--text); line-height:1.2;"><%= staffNotice.title %></h2>
      <% } %>
      <% if (staffNotice.subtitle) { %>
        <p style="margin:0 0 16px; font-size:0.9rem; font-weight:600; color:var(--brand);"><%= staffNotice.subtitle %></p>
      <% } %>
      <% if (staffNotice.body) { %>
        <p style="margin:0 0 24px; font-size:0.88rem; color:var(--text-mid); line-height:1.6; text-align:left; white-space:pre-wrap;"><%= staffNotice.body %></p>
      <% } %>
      <button onclick="dismissNotice()" class="btn btn-primary" style="width:100%; font-size:1rem; padding:13px;">Got it</button>
    </div>
  </div>
  <style>
    @keyframes slideUp {
      from { opacity:0; transform:translateY(16px); }
      to   { opacity:1; transform:translateY(0); }
    }
  </style>
  <script>
    (function() {
      var KEY = 'notice_dismissed_<%= Date.now() - (Date.now() % 86400000) %>';
      if (sessionStorage.getItem('notice_dismissed')) {
        var el = document.getElementById('noticeOverlay');
        if (el) el.style.display = 'none';
      }
    })();
    function dismissNotice() {
      sessionStorage.setItem('notice_dismissed', '1');
      var el = document.getElementById('noticeOverlay');
      if (el) { el.style.opacity = '0'; el.style.transition = 'opacity 0.2s'; setTimeout(function(){ el.style.display='none'; }, 200); }
    }
  </script>
  <% } %>
</body>
</html>
