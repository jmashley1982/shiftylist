<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>No Tasks Available</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/admin/dashboard" class="brand">
      <img src="/vvas-logo.png" alt="VVAS">
      <img src="/shiftylist-logo.png" alt="ShiftyList" class="brand-platform-logo">
    </a>
    <a href="/logout" class="btn btn-ghost btn-sm" style="min-height:36px;padding:7px 12px;">Log out</a>
  </nav>
  <div class="main-content-notabs" style="display:flex; align-items:center; justify-content:center; min-height:calc(100dvh - 60px);">
    <div style="width:100%; max-width:400px;">
      <div style="text-align:center; margin-bottom:28px;">
        <div style="font-size:3rem; margin-bottom:12px;">📅</div>
        <h1 style="font-size:1.3rem; margin-bottom:6px;">No tasks available</h1>
        <p style="color:var(--muted); font-size:0.88rem; line-height:1.5;">
          Hi <strong><%= employeeName %></strong> — there are no published shifts for today yet.
        </p>
      </div>
      <div class="panel" style="text-align:center;">
        <div class="alert alert-info" style="margin-bottom:16px;">Ask your manager to publish today's shifts.</div>
        <a href="/logout" class="btn btn-ghost btn-full">Log Out</a>
      </div>
    </div>
  </div>
</body>
</html>
