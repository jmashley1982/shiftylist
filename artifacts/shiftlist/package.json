{
  "name": "@workspace/shiftlist",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:views": "node ./scripts/gen-views.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "pnpm run gen:views && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "pnpm run gen:views && tsc -p tsconfig.json --noEmit",
    "cf:dev": "pnpm run gen:views && wrangler dev --var NODE_ENV:development",
    "cf:deploy": "pnpm run gen:views && wrangler deploy",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "date-fns": "^3.6.0",
    "drizzle-orm": "catalog:",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "esbuild": "0.27.3",
    "wrangler": "^4.44.0"
  }
}
