{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shiftylist",
  "main": "./src/worker.ts",

  // >= 2025-08-15 for httpServerHandler, >= 2025-09-01 for the node:fs stubs,
  // >= 2025-04-01 for process.env being populated from vars and secrets.
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": true,

  // Served at the edge before the Worker runs, so /style.css, /vvas-logo.png
  // and /shiftylist-logo.png never reach Express. `not_found_handling` is
  // deliberately unset (defaults to "none") so every other path falls through
  // to the Worker — "single-page-application" would swallow /login and /admin/*.
  "assets": {
    "directory": "./public"
  },

  // Create with:
  //   npx wrangler hyperdrive create shiftylist-db --connection-string="postgres://..."
  // then paste the returned id here.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      // Used only by `wrangler dev` — point it at a local or dev Postgres.
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/shiftlist"
    }
  ],

  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    "STORE_TIMEZONE": "America/Chicago"
  },

  // SESSION_SECRET and ADMIN_CODE are secrets, not vars:
  //   npx wrangler secret put SESSION_SECRET
  //   npx wrangler secret put ADMIN_CODE
  // ADMIN_CODE falls back to "1234" if unset — set it before going live.

  "observability": {
    "enabled": true
  },

  "limits": {
    // Workers Paid only. Express routing plus an EJS render of the larger
    // admin pages will not fit in the Free plan's 10 ms CPU ceiling.
    "cpu_ms": 30000
  },

  "placement": {
    // Run the isolate near Hyperdrive's origin connection — the admin pages
    // issue several sequential queries per request.
    "mode": "smart"
  },

  // Hourly: auto-submits stale shift sessions and prunes expired logins.
  "triggers": {
    "crons": ["5 * * * *"]
  }

  // The Viking store's instance lives on the subdomain; the apex is left alone.
  //
  // "routes": [{ "pattern": "viking.shiftylist.app", "custom_domain": true }]
  //
  // Left commented out on purpose: viking.shiftylist.app currently points at
  // the Replit deployment, and attaching a custom domain *replaces* that DNS
  // record. Uncommenting and deploying is therefore the cutover itself, not a
  // preparatory step. Verify on the workers.dev URL first.
  //
  // If the deploy is refused because a DNS record already exists for the
  // hostname, delete the Replit CNAME first (or accept the override prompt in
  // the dashboard). To roll back: remove the custom domain and re-point the
  // CNAME at Replit.
}
