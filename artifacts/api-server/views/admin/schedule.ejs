<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Schedule Tasks</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'schedule' }) %>
  <div class="main-content">
    <h1 style="margin-bottom:8px;">Schedule One-Off Tasks</h1>
    <p class="subtitle" style="margin-bottom:24px;">Assign extra tasks to specific employees for any date in the next 14 days.</p>

    <div class="panel">
      <div class="panel-header"><h2 style="margin:0;">Add Scheduled Task</h2></div>
      <% if (employees.length === 0) { %>
        <div class="alert alert-info">No employees yet. <a href="/admin/employees">Add employees first →</a></div>
      <% } else { %>
        <form method="POST" action="/admin/schedule/add">
          <div class="form-row">
            <div class="form-group">
              <label>Employee</label>
              <select name="employee_id" required>
                <% employees.forEach(function(emp) { %>
                  <option value="<%= emp.id %>"><%= emp.name %> (<%= emp.shift_name %>)</option>
                <% }); %>
              </select>
            </div>
            <div class="form-group">
              <label>Date</label>
              <select name="target_date" required>
                <% futureDates.forEach(function(d, i) { %>
                  <option value="<%= d %>" <%= i === 0 ? 'selected' : '' %>><%= formatDateDisplay(d) %><%= i === 0 ? ' (Today)' : '' %></option>
                <% }); %>
              </select>
            </div>
            <div class="form-group" style="flex:2;">
              <label>Task Description</label>
              <input type="text" name="task_text" placeholder="e.g. Deep clean fridges" required>
            </div>
            <div class="form-group" style="justify-content:flex-end;">
              <button type="submit" class="btn btn-primary">Add Task</button>
            </div>
          </div>
        </form>
      <% } %>
    </div>

    <div class="panel">
      <div class="panel-header">
        <h2 style="margin:0;">Upcoming Scheduled Tasks (<%= scheduled.length %>)</h2>
      </div>
      <% if (scheduled.length > 0) { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Employee</th>
                <th>Task</th>
                <th style="width:80px;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% scheduled.forEach(function(task) { %>
                <tr>
                  <td style="white-space:nowrap;">
                    <%= formatDateDisplay(task.target_date) %>
                    <% if (task.target_date === today) { %>
                      <span style="font-size:0.75rem;color:var(--warning);font-weight:700;margin-left:4px;">TODAY</span>
                    <% } %>
                  </td>
                  <td>
                    <strong><%= task.employee_name %></strong>
                    <span class="shift-badge" style="font-size:0.72rem;margin-left:6px;"><%= task.shift_name %></span>
                  </td>
                  <td><%= task.task_text %></td>
                  <td>
                    <form method="POST" action="/admin/schedule/delete/<%= task.id %>" onsubmit="return confirm('Remove this task?')">
                      <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="color:var(--muted);font-size:0.9rem;">No upcoming scheduled tasks.</p>
      <% } %>
    </div>
  </div>
</body>
</html>
