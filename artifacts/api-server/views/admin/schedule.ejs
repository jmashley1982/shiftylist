<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Schedule Tasks</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'schedule' }) %>
  <div class="main-content">
    <div class="page-header" style="margin-top:12px;">
      <h1>Schedule</h1>
      <p>One-off tasks for the next 14 days</p>
    </div>

    <div class="panel">
      <div class="panel-header"><h2>Add Task</h2></div>
      <% if (employees.length === 0) { %>
        <div class="alert alert-info" style="margin-bottom:0;">No employees yet. <a href="/admin/employees">Add staff first →</a></div>
      <% } else { %>
        <form method="POST" action="/admin/schedule/add" class="form-stack">
          <div class="form-group">
            <label>Employee</label>
            <select name="employee_id" required>
              <% employees.forEach(function(emp) { %>
                <option value="<%= emp.id %>"><%= emp.name %> (<%= emp.shift_name %>)</option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>Date</label>
            <select name="target_date" required>
              <% futureDates.forEach(function(d, i) { %>
                <option value="<%= d %>" <%= i === 0 ? 'selected' : '' %>>
                  <%= formatDateDisplay(d) %><%= i === 0 ? ' (Today)' : '' %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>Task Description</label>
            <input type="text" name="task_text" placeholder="e.g. Deep clean fridges" required>
          </div>
          <button type="submit" class="btn btn-primary btn-full">Schedule Task</button>
        </form>
      <% } %>
    </div>

    <% if (scheduled.length > 0) { %>
      <div class="panel">
        <div class="panel-header">
          <h2>Upcoming (<%= scheduled.length %>)</h2>
        </div>
        <div style="display:flex; flex-direction:column; gap:10px;">
          <% scheduled.forEach(function(task) { %>
            <div style="display:flex; align-items:flex-start; gap:12px; padding-bottom:10px; border-bottom:1px solid var(--border);">
              <div style="flex:1; min-width:0;">
                <div style="font-weight:700; font-size:0.9rem; margin-bottom:4px;"><%= task.employee_name %></div>
                <div style="font-size:0.85rem; color:var(--text); margin-bottom:4px;"><%= task.task_text %></div>
                <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                  <span class="date-badge <%= task.target_date === today ? 'date-badge-today' : '' %>">
                    <%= formatDateDisplay(task.target_date) %><%= task.target_date === today ? ' · Today' : '' %>
                  </span>
                  <span class="shift-badge"><%= task.shift_name %></span>
                </div>
              </div>
              <form method="POST" action="/admin/schedule/delete/<%= task.id %>" onsubmit="return confirm('Remove this task?')">
                <button type="submit" class="btn btn-danger btn-sm">✕</button>
              </form>
            </div>
          <% }); %>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-info">No upcoming scheduled tasks.</div>
    <% } %>
  </div>
</body>
</html>
