<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'dashboard' }) %>
  <div class="main-content">
    <h1 style="margin-bottom:8px;">Dashboard</h1>
    <p class="subtitle" style="margin-bottom:24px;">Overview of your team's shift setup</p>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value"><%= employeeCount %></div>
        <div class="stat-label">Employees</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= shiftNames.length %></div>
        <div class="stat-label">Shift Types</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= upcomingCount %></div>
        <div class="stat-label">Upcoming One-Off Tasks</div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-header"><h2 style="margin:0;">Shift Types</h2></div>
      <% if (shiftNames.length > 0) { %>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <% shiftNames.forEach(function(s) { %>
            <span class="shift-badge" style="font-size:0.9rem; padding:6px 16px;"><%= s %></span>
          <% }); %>
        </div>
      <% } else { %>
        <p style="color:var(--muted); font-size:0.9rem;">No shift templates yet. <a href="/admin/shifts">Add shifts →</a></p>
      <% } %>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:12px;">
      <a href="/admin/employees" class="btn btn-outline" style="padding:16px; text-align:center; border-radius:9px;">Manage Employees</a>
      <a href="/admin/shifts" class="btn btn-outline" style="padding:16px; text-align:center; border-radius:9px;">Manage Shift Templates</a>
      <a href="/admin/schedule" class="btn btn-outline" style="padding:16px; text-align:center; border-radius:9px;">Schedule Tasks</a>
      <a href="/admin/reports" class="btn btn-outline" style="padding:16px; text-align:center; border-radius:9px;">View Reports</a>
    </div>
  </div>
</body>
</html>
