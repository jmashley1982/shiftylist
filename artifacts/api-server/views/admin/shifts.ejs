<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shift Templates</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'shifts' }) %>
  <div class="main-content">
    <h1 style="margin-bottom:24px;">Shift Templates</h1>

    <div class="panel">
      <div class="panel-header"><h2 style="margin:0;">Create New Shift Type</h2></div>
      <form method="POST" action="/admin/shifts/add-shift">
        <div class="form-row">
          <div class="form-group" style="flex:2;">
            <label>Shift Name</label>
            <input type="text" name="shift_name" placeholder="e.g. Open, Mid, Close" required>
          </div>
          <div class="form-group" style="justify-content:flex-end;">
            <button type="submit" class="btn btn-primary">Create Shift</button>
          </div>
        </div>
      </form>
    </div>

    <% if (shiftNames.length > 0) { %>
      <div class="panel">
        <div class="panel-header"><h2 style="margin:0;">Add Task to Shift</h2></div>
        <form method="POST" action="/admin/shifts/add-task">
          <div class="form-row">
            <div class="form-group">
              <label>Shift</label>
              <select name="shift_name" required>
                <% shiftNames.forEach(function(s) { %>
                  <option value="<%= s %>"><%= s %></option>
                <% }); %>
              </select>
            </div>
            <div class="form-group" style="flex:3;">
              <label>Task Description</label>
              <input type="text" name="task_text" placeholder="e.g. Count cash drawer" required>
            </div>
            <div class="form-group" style="max-width:100px;">
              <label>Order</label>
              <input type="number" name="display_order" placeholder="0" min="0" value="0">
            </div>
            <div class="form-group" style="justify-content:flex-end;">
              <button type="submit" class="btn btn-primary">Add Task</button>
            </div>
          </div>
        </form>
      </div>

      <% shiftNames.forEach(function(shiftName) { %>
        <div class="panel">
          <div class="panel-header">
            <h2 style="margin:0;"><span class="shift-badge" style="font-size:1rem;"><%= shiftName %></span></h2>
            <span style="color:var(--muted);font-size:0.85rem;"><%= tasksByShift[shiftName].length %> tasks</span>
          </div>
          <% if (tasksByShift[shiftName].length > 0) { %>
            <div class="table-wrapper">
              <table>
                <thead>
                  <tr>
                    <th>Order</th>
                    <th>Task</th>
                    <th style="width:80px;">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% tasksByShift[shiftName].forEach(function(task) { %>
                    <tr>
                      <td style="color:var(--muted);"><%= task.display_order %></td>
                      <td><%= task.task_text %></td>
                      <td>
                        <form method="POST" action="/admin/shifts/delete-task/<%= task.id %>" onsubmit="return confirm('Remove this task?')">
                          <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p style="color:var(--muted);font-size:0.9rem;">No tasks yet. Add one above.</p>
          <% } %>
        </div>
      <% }); %>
    <% } else { %>
      <div class="alert alert-info">No shift types created yet. Create one above to get started.</div>
    <% } %>
  </div>
</body>
</html>
